   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0436_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>mṭrpnʾh ẔNH BYRḤ
               <lb n="2" xml:id="trl-p1-l2"/>ddwˈ Y ŠNṬ $X-IIII lwcyk
               <lb n="3" xml:id="trl-p1-l3"/>Y ṭpkwdy(?) lʾd BSLYʾ-X-III-II
               <lb n="4" xml:id="trl-p1-l4"/>krṭkˈ ʿL plhwˈ-wʾlʾn Y dwsṭʾn
               <lb n="5" xml:id="trl-p1-l5"/>YḤBWNṭˈ ckˈ plhwʾn ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0436_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Mihrpanāh ēn māh
               <lb n="2" xml:id="trc-p1-l2"/>Day ī sāl 34 rōzīg
               <lb n="3" xml:id="trc-p1-l3"/>ī Tabagōy(?) rāy gōšt-15
               <lb n="4" xml:id="trc-p1-l4"/>kardag ō Farrox-Wārān ī Dōstān
               <lb n="5" xml:id="trc-p1-l5"/>dād čak Farroxān āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0436_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Mihrpanāh diesen Monat
               <lb n="2" xml:id="trans-p1-l2"/>Day (10.Monat) des Jahres 34 der Ration
               <lb n="3" xml:id="trans-p1-l3"/>des Tabagōy(?) wegen Fleisch 15
               <lb n="4" xml:id="trans-p1-l4"/>Portionen dem Farrox-Wārān, Sohn des Dōst,
               <lb n="5" xml:id="trans-p1-l5"/>gegeben. Den Scheck (hat) Farroxān gesiegelt.
            </ab>
         </div>
      </body>
   </text>
