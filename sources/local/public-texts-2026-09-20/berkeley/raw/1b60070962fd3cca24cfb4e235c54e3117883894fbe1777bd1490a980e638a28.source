      <profileDesc>
         <textClass>
            <keywords>
               <term type="DocType">Receipt</term>
               <term type="corpus">Central Iran</term>
               <term type="location">Yazdān-ābestān</term>
               <term type="location">Namēwar</term>
               <term type="location">Dalīgān</term>
               <term type="location">Paywēr</term>
               <term type="tag">az ān ī ō bun</term>
