   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85284-66.recto_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0071_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>hwlyn’ MN ẔK Y ʾL bwn’ ẔNH
               <lb n="2" xml:id="trl-p1-l2"/>BYRḤ ṭyl QDM ŠNT $$-IIII-IIII
               <lb n="3" xml:id="trl-p1-l3"/>MN lšnyk <gap extent="several words" reason="tear"/> G-III ʾL mzgṭ’
               <lb n="4" xml:id="trl-p1-l4"/>Y BYRḤ <gap extent="several words" reason="tear"/>ṭn(‘) Y kʾl
               <lb n="5" xml:id="trl-p1-l5"/>LWṬH <gap extent="several words" reason="tear"/> PWN bwdsṭʾn
               <lb n="6" xml:id="trl-p1-l6"/>XX <gap extent="several words" reason="tear"/>
               <lb n="7" xml:id="trl-p1-l7"/><gap extent="several words" reason="tear"/>
               <lb n="8" xml:id="trl-p1-l8"/><gap extent="several words" reason="tear"/>
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0071_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Xwarin az ān ī ō bun ēn
               <lb n="2" xml:id="trc-p1-l2"/>māh Tīr abar sāl 48
               <lb n="3" xml:id="trc-p1-l3"/>az Rašnīg <gap extent="several words" reason="tear"/> g(rīw) 3 ō mazgit
               <lb n="4" xml:id="trc-p1-l4"/>ī māh <gap extent="several words" reason="tear"/>tan ī kār
               <lb n="5" xml:id="trc-p1-l5"/>abāg <gap extent="several words" reason="tear"/> pad bōyestān
               <lb n="6" xml:id="trc-p1-l6"/>20 <gap extent="several words" reason="tear"/>
               <lb n="7" xml:id="trc-p1-l7"/><gap extent="several words" reason="tear"/>
               <lb n="8" xml:id="trc-p1-l8"/><gap extent="several words" reason="tear"/>
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0071_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Xwarin from that which (belongs) to the bun, this
               <lb n="2" xml:id="trans-p1-l2"/>month Tīr in the year 48
               <lb n="3" xml:id="trans-p1-l3"/>from Rašnīg <gap extent="several words" reason="tear"/> 3 grīw to the mosque
               <lb n="4-8" xml:id="trans-p1-l4-8"/>no coherent translation possible
            </ab>
         </div>
      </body>
   </text>
