   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85283-64.recto_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0069_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>[dʾṭyn]wndʾṭ ẔNH BRYḤ mṭr'
               <lb n="2" xml:id="trl-p1-l2"/>[YWM ṭyl ?] SWSYʾ-2
               <lb n="3" xml:id="trl-p1-l3"/>... mʾhpylwc' LWṬH
               <lb n="4" xml:id="trl-p1-l4"/>... ʾywlwck'
               <lb n="5" xml:id="trl-p1-l5"/>lʾd ʾspsṭ' 10-4-4
               <lb n="6" xml:id="trl-p1-l6"/>W Šg K-6 ʿL lsyk
               <lb n="7" xml:id="trl-p1-l7"/>Y ...-gwšnsp' ? YḤBWNṭ W
               <lb n="8" xml:id="trl-p1-l8"/>... (Y yzdʾnpʾṭʾl) BYRḤ
               <lb n="8bis" xml:id="trl-p1-l8bis"/>{bʾ} ʾpʾn
               <lb n="9" xml:id="trl-p1-l9"/>YWM ṭyl SWSYʾ Y plḥwdʾn
               <lb n="10" xml:id="trl-p1-l10"/>lʾd ʿL plḥwdʾn ʾspsṭ' 6
               <lb n="11" xml:id="trl-p1-l11"/>glṭk Šg K-3 ○...
               <lb n="12" xml:id="trl-p1-l12"/>W plhwhwslwy ʾspsṭ' 10 glṭk
               <lb n="13" xml:id="trl-p1-l13"/>Šg K-3 ○
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0069_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Dādēnvindād ēn māh Mihr
               <lb n="2" xml:id="trc-p1-l2"/>[rōz Tīr ?] asp 2
               <lb n="3" xml:id="trc-p1-l3"/>... Māh-Pērōz abāg
               <lb n="4" xml:id="trc-p1-l4"/>... ēw-rōzag
               <lb n="5" xml:id="trc-p1-l5"/>rāy aspast 18
               <lb n="6" xml:id="trc-p1-l6"/>ud jaw kabīz 6 ō rahīg
               <lb n="7" xml:id="trc-p1-l7"/>ī ...-Gušnasp ? dād ud
               <lb n="8" xml:id="trc-p1-l8"/>(ī Yazdān-pādār) māh
               <lb n="8bis" xml:id="trc-p1-l8bis"/>Ābān
               <lb n="9" xml:id="trc-p1-l9"/>rōz Tīr asp ī Farroxdān
               <lb n="10" xml:id="trc-p1-l10"/>rāy ō Farroxdān aspast 6
               <lb n="11" xml:id="trc-p1-l11"/>girdag jaw kabīz 3 ○ ...
               <lb n="12" xml:id="trc-p1-l12"/>ud Farrox-Xusrōy aspast 10 girdag
               <lb n="13" xml:id="trc-p1-l13"/>jaw kabīz 3 ○
            </ab>
         </div>
         <div type="translation" xml:lang="fr">
            <ab xml:id="MP0069_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dādēnvindād, ce mois de Mihr
               <lb n="2" xml:id="trans-p1-l2"/>[le jour de Tīr ?], les deux chevaux de
               <lb n="3" xml:id="trans-p1-l3"/>... Māh-Pērōz avec ...
               <lb n="4" xml:id="trans-p1-l4"/>pour un jour, a remis
               <lb n="5" xml:id="trans-p1-l5"/>18 [bottes] de luzerne
               <lb n="6" xml:id="trans-p1-l6"/>et 6 kabīz d'orge au serviteur
               <lb n="7" xml:id="trans-p1-l7"/>de ...-Gušnasp, et
               <lb n="8" xml:id="trans-p1-l8"/>(Yazdān-pādār ?), le mois de
               <lb n="8bis" xml:id="trans-p1-l8bis"/>Ābān et le
               <lb n="9" xml:id="trans-p1-l9"/>jour de Tīr, (pour) le cheval de Farroxdān
               <lb n="10" xml:id="trans-p1-l10"/>(il a remis) 6 bottes de luzerne
               <lb n="11" xml:id="trans-p1-l11"/>et 3 kabīz d'orge, et (pour celui de)
               <lb n="12" xml:id="trans-p1-l12"/>Farrox-Xusrōy 10 bottes de luzerne
               <lb n="13" xml:id="trans-p1-l13"/>et 3 kabīz d'orge.
            </ab>
         </div>
      </body>
   </text>
</TEI>