   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
             <pb xml:id="pb-1r-trl"/><!--facs="local:"-->
            <ab xml:id="MP2102_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>].[
               <lb n="2" xml:id="trl-p1-l2"/>]cygwn ʾp̄ʾ[yt?
               <lb n="3" xml:id="trl-p1-l3"/>]. kwhškyh? Y[
               <lb n="4" xml:id="trl-p1-l4"/>....[ Y]BLWNṭ' ʾp̄ʾyṭ'[ p](l)mwt' W
               <lb n="5" xml:id="trl-p1-l5"/>.... ʿD ʿL lykws YWM gw(š)?[ MN?
               <lb n="6" xml:id="trl-p1-l6"/>BYRḤ spndrmt ʾL kʾhyt'
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP2102_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>].[
               <lb n="2" xml:id="trc-p1-l2"/>]čiyōn abā[yēd?
               <lb n="3" xml:id="trc-p1-l3"/>]. kōxšagīh? ī[
               <lb n="4" xml:id="trc-p1-l4"/>....[ b]urd? abāyēd[ f]ramūd ud
               <lb n="5" xml:id="trc-p1-l5"/>.... tā ō Likos rōz Gōš?[ az?
               <lb n="6" xml:id="trc-p1-l6"/>māh Spandarmad ma kāhēd
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP2102_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>].[
               <lb n="2" xml:id="trans-p1-l2"/>]wie es nötig [ist?
               <lb n="3" xml:id="trans-p1-l3"/>]. Anstrengung? des[
               <lb n="4" xml:id="trans-p1-l4"/>....[ zu br]ingen nötig ist, befahl er und
               <lb n="5" xml:id="trans-p1-l5"/>.... bis nach Lykos (am) Tag Gōš? (14. Tag) [vom?
               <lb n="6" xml:id="trans-p1-l6"/>Monat Spandarmad (12. Monat). Keine Verögerung!?
            </ab>
         </div>
      </body>
   </text>
