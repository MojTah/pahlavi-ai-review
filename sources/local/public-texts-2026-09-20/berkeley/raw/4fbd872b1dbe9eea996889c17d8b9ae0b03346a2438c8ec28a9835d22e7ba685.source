   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="local:"-->
            <ab xml:id="MP2352_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ʿL hmʾy pṭ' ///[
               <lb n="2" xml:id="trl-p1-l2"/>MN? nc? hwdʾhk? hm? cnd...ʾsṭ'
               <lb n="3" xml:id="trl-p1-l3"/>W nyw....yh? LWṬH ṭn'drwdsṭyh
               <lb n="4" xml:id="trl-p1-l4"/>W lʾmšn' dʾmyk'? hwlʾm W ʾp̄ymwsṭ' Y
               <lb n="5" xml:id="trl-p1-l5"/>MRʿḤ lʾd YKṬYBWN(m) ʾp̄ymwsṭ' Y
               <lb n="6" xml:id="trl-p1-l6"/>MN ẔK nʾmdʾlyh Y p[
               <lb n="7" xml:id="trl-p1-l7"/>ʿL l...[     ]... pṭ'[
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP2352_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>ō hamē pad ....[
               <lb n="2" xml:id="trc-p1-l2"/>az? namāz? hudāhag? ham? čand... ...
               <lb n="3" xml:id="trc-p1-l3"/>ud nēw-...-īh abāg tandrustīh
               <lb n="4" xml:id="trc-p1-l4"/>ud rāmišn ... ...-hurām ud abēmust ī
               <lb n="5" xml:id="trc-p1-l5"/>xwadāy rāy nibēsē(m) kū
               <lb n="6" xml:id="trc-p1-l6"/>az ān nāmdārīh ī p[
               <lb n="7" xml:id="trc-p1-l7"/>ō r... ... pad[
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP2352_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>An den stets mit....[
               <lb n="2" xml:id="trans-p1-l2"/>aus? Verehrung? wohltätig ... ...
               <lb n="3" xml:id="trans-p1-l3"/>und Wohl-...-keit, mit Gesundheit
               <lb n="4" xml:id="trans-p1-l4"/>und Frieden, ... ...-glücklich? und zufrieden,
               <lb n="5" xml:id="trans-p1-l5"/>des Herrn wegen schreibe ich:
               <lb n="6" xml:id="trans-p1-l6"/>Aufgrund des Namens? ....[
               <lb n="7" xml:id="trans-p1-l7"/>zu ... ... mit[
            </ab>
         </div>
      </body>
   </text>
</TEI>