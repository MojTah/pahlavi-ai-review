         </calendarDesc>
         <particDesc>
            <p>A short list of greetings and acknowledgement of compensation for a man by the name of *<persName ref="people:CIr014">Tabīg</persName>.</p>
            <p>People named are <persName ref="people:CIr011">Pērōz-Xusrō ī Spihrdād</persName>, <persName ref="people:CIr012">Warāz ī Ōzōy</persName>, <persName ref="people:CIr013">Spihrdād ī Dēnīg</persName>, and <persName ref="people:CIr014">Tabīg</persName>.</p>
            <p>The document is undated.</p>
         </particDesc>
         <settingDesc>
            <p><placeName>*Astōg</placeName></p>
         </settingDesc>
         <creation>
            <date when-custom="undated" calendar="#Pahlavi">Undated</date>
            <date when-custom="undated" calendar="#Julian">Undated</date>
         </creation>
      </profileDesc>
