      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0415_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>hwlynˈ MN ẔK Y ʿL bwnˈ
               <lb n="2" xml:id="trl-p1-l2"/>ẔNH BYRḤ hwrdṭˈ Y
               <lb n="3" xml:id="trl-p1-l3"/>ŠNṬ $$-IIII-IIII YWM
               <lb n="4" xml:id="trl-p1-l4"/>ʾmwrdṭ ʾMṬ kwʾṭgwnd(?)
               <lb n="5" xml:id="trl-p1-l5"/>blswm Y pṭˈ //////////
               <lb n="6" xml:id="trl-p1-l6"/>nwk pʾṭyndʾn shyṭˈ(?)
               <lb n="7" xml:id="trl-p1-l7"/>ʿL ʾhwdʾṭˈ GBRʾn
               <lb n="8" xml:id="trl-p1-l8"/>$-IIII Y LWṬH
               <lb n="9" xml:id="trl-p1-l9"/>kwʾṭgwnd(?) pṭˈ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0415_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Xwarin az ān ī ō bun
               <lb n="2" xml:id="trc-p1-l2"/>ēn māh Hordād ī
               <lb n="3" xml:id="trc-p1-l3"/>sāl 48 rōz
               <lb n="4" xml:id="trc-p1-l4"/>Amurdād ka Kawādgung(?)
               <lb n="5" xml:id="trc-p1-l5"/>barsom ī pad //////////
               <lb n="6" xml:id="trc-p1-l6"/>nōg pāyēndān sahēd(?)
               <lb n="7" xml:id="trc-p1-l7"/>ō Axwdād mardān
               <lb n="8" xml:id="trc-p1-l8"/>24 ī abāg
               <lb n="9" xml:id="trc-p1-l9"/>Kawādgung(?) pad
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0415_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Xwarin: Von ihm zur ,,Zentrale“.
               <lb n="2" xml:id="trans-p1-l2"/>Diesen Monat Hordād (3. Monat) des
               <lb n="3" xml:id="trans-p1-l3"/>Jahres 48, Tag
               <lb n="4" xml:id="trans-p1-l4"/>Amurdād (7. Tag), als/wenn Kawādgund(?)
               <lb n="5" xml:id="trans-p1-l5"/>barsom-Zweige durch/für ......
               <lb n="6" xml:id="trans-p1-l6"/>ein neuer Bürge scheint angebracht(?).
               <lb n="7" xml:id="trans-p1-l7"/>Dem Axwdād Mann (Männer)
               <lb n="8" xml:id="trans-p1-l8"/>24 die (zusammen) mit
               <lb n="9" xml:id="trans-p1-l9"/>Kawādgund(?) des für ... (abgebrochen)
            </ab>
         </div>
      </body>
   </text>
