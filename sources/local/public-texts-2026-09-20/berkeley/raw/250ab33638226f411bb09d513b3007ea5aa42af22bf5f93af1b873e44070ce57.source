   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/>
            <ab xml:id="MP0500_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>plykˈ Y pṭ[ˈ]
               <lb n="2" xml:id="trl-p1-l2"/>nmṭl dʾlyk (MN)
               <lb n="3" xml:id="trl-p1-l3"/>ẔK ʾYŠ ʿL bwn[ˈ]
               <lb n="4" xml:id="trl-p1-l4"/>ẔNH BYRḤ ṭyl Y
               <lb n="5" xml:id="trl-p1-l5"/>ŠNṬ $X-IIII-IIII
               <lb n="6" xml:id="trl-p1-l6"/>cygwn ʾMYṭl Y hwslwdʾn
               <lb n="7" xml:id="trl-p1-l7"/>plmwṭ BʿYḤWNsṭnˈ yʾmkˈ
               <lb n="8" xml:id="trl-p1-l8"/>*swsṭnˈ lʾd gwpṭˈ ʾYḴ
               <lb n="9" xml:id="trl-p1-l9"/>ḤG K-#III-II ʿL
               <lb n="10" xml:id="trl-p1-l10"/>plsṭʾlʾn ʾYŠ LʿYNˈ
               <lb n="11" xml:id="trl-p1-l11"/>YḤBWNṭˈ zʾṭʾnplhwˈ
               <lb n="12" xml:id="trl-p1-l12"/>Y šṭrplhwˈ ḤṬY(MWNṭ)
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0500_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Friyag ī pad
               <lb n="2" xml:id="trc-p1-l2"/>namtar dārīg (az)
               <lb n="3" xml:id="trc-p1-l3"/>ān kas ō bun
               <lb n="4" xml:id="trc-p1-l4"/>ēn māh Tīr ī
               <lb n="5" xml:id="trc-p1-l5"/>sāl 38
               <lb n="6" xml:id="trc-p1-l6"/>čiyōn mādar ī Xusrōyān
               <lb n="7" xml:id="trc-p1-l7"/>framūd xwāstan ǰāmag
               <lb n="8" xml:id="trc-p1-l8"/>*sustan rāy guft kū
               <lb n="9" xml:id="trc-p1-l9"/>gandum kabīz-5 ō
               <lb n="10" xml:id="trc-p1-l10"/>paristārān kas pēš
               <lb n="11" xml:id="trc-p1-l11"/>dād Zādānfarrox
               <lb n="12" xml:id="trc-p1-l12"/>ī Šahr-Farrox āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0500_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Friyag, der Verwalter
               <lb n="2" xml:id="trans-p1-l2"/>in Namtar. Von
               <lb n="3" xml:id="trans-p1-l3"/>jenem zur „Zentrale“.
               <lb n="4" xml:id="trans-p1-l4"/>Diesen Monat Tīr (4. Monat) des
               <lb n="5" xml:id="trans-p1-l5"/>Jahres 38 (669/670 n. Chr.):
               <lb n="6" xml:id="trans-p1-l6"/>Wie die Mutter des Xusrōyān
               <lb n="7-8" xml:id="trans-p1-l7-8"/>befahl zu verlangen wegen des *Nähens eines Kleidungsstückes, und zwar:
               <lb n="9" xml:id="trans-p1-l9"/>Weizen kabīz 5 den
               <lb n="10" xml:id="trans-p1-l10"/>Dienerinnen jemand vorher
               <lb n="11" xml:id="trans-p1-l11"/>gegeben. Zādānfarrox,
               <lb n="12" xml:id="trans-p1-l12"/>Sohn des Šahr-Farrox, (hat’s) gesiegelt.
            </ab>
         </div>
      </body>
   </text>
</TEI>