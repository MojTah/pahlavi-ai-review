   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!-- Add later facs="LA:UNKNOWN" -->
            <ab xml:id="MP0453_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>L <persName ref="people:CIr017">ʾbwd</persName> Y ʿL ʾBˈ
               <lb n="2" xml:id="trl-p1-l2"/>BRʾ YʾTWNṭˈ ʾBˈ
               <lb n="3" xml:id="trl-p1-l3"/>YCBNHsṭˈ cygwn ʾkʾsyh
               <lb n="4" xml:id="trl-p1-l4"/>hmgwnkˈ mṭ(?) ẔK *<persName ref="people:CIr016">ysnpʾṭʾl</persName>
               4bis ʿL ʾBˈ(?)
               <lb n="5" xml:id="trl-p1-l5"/>...... pṭˈ ṬḆ(?) ......
               <lb n="6" xml:id="trl-p1-l6"/>... LʾWḤL mṭrˈ
               <lb n="7" xml:id="trl-p1-l7"/>Y ʾkʾsyh Y MN
               <lb n="8" xml:id="trl-p1-l8"/>............ cygwn
               <lb n="9" xml:id="trl-p1-l9"/>plmʾyṭ BRʾ YʾṬWNṭn
               <lb n="10" xml:id="trl-p1-l10"/>L s-............
               <lb n="11" xml:id="trl-p1-l11"/>YWM gwš(?) BRʾ YḤWWNm
               <lb n="12" xml:id="trl-p1-l12"/><persName ref="people:CIr002">dʾṭynˈ</persName> lʾd plmʾy
               <lb n="13" xml:id="trl-p1-l13"/>npštnˈ
            </ab>
         </div>
         <!--No transcription published
            <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0453_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>none
            </ab>
         </div>
         -->
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0453_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Ich, Ābōy, zum Vater
               <lb n="2" xml:id="trans-p1-l2"/>gekommen, der Vater
               <lb n="3" xml:id="trans-p1-l3"/>wünschte: wie Kenntnis,
               <lb n="4" xml:id="trans-p1-l4"/>ebenso falsch(?) der *Yasn-pādār
               <lb n="5" xml:id="trans-p1-l5"/>...
               <lb n="6" xml:id="trans-p1-l6"/>... wie- der Freundschaft der Kenntnis der von
               <lb n="7" xml:id="trans-p1-l7"/>...
               <lb n="8" xml:id="trans-p1-l8"/>......... wie
               <lb n="9" xml:id="trans-p1-l9"/>er befiehlt zu kommen,
               <lb n="10" xml:id="trans-p1-l10"/>.........
               <lb n="11" xml:id="trans-p1-l11"/>Tag Gōš (14. Tag) werde ich da sein
               <lb n="12" xml:id="trans-p1-l12"/>Wegen Dādēn befiehl
               <lb n="13" xml:id="trans-p1-l13"/>zu schreiben.
            </ab>
         </div>
      </body>
   </text>
</TEI>