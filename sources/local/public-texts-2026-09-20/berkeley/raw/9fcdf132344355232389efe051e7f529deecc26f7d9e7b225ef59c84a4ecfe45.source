   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85290-71.recto_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0076_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>dʾṭynwndʾṭ ẔNH
               <lb n="2" xml:id="trl-p1-l2"/>ddw' PWN mṭr'
               <lb n="3" xml:id="trl-p1-l3"/>ŠG K-#II SWSYʾ
               <lb n="4" xml:id="trl-p1-l4"/>(ẔK Y) syʾlʾn
               <lb n="5" xml:id="trl-p1-l5"/>YḤBWNṭ'
               <lb n="6" xml:id="trl-p1-l6"/>YWM mṭr'
               <lb n="7" xml:id="trl-p1-l7"/>spʾlk
               <lb n="8" xml:id="trl-p1-l8"/>ʾsṭl Y
               <lb n="9" xml:id="trl-p1-l9"/>ʾṭwrdʾṭ' ʾlṭ (?)[
               <lb n="10" xml:id="trl-p1-l10"/>ŠG K-#I
               <lb n="11" xml:id="trl-p1-l11"/>whʾk ... (line 12 torn off)
            </ab>
            <ab xml:id="MP0076_trl-p2">
               <addSpan place="top" spanTo="#trl-p2-l5" style="writing-mode: sideways-rl"/>
               <lb n="1" xml:id="trl-p2-l1"/>(above, vertically)SWSYʾ Y
               <lb n="2" xml:id="trl-p2-l2"/>plhwzʾṭ'
               <lb n="3" xml:id="trl-p2-l3"/>YWM mṭr'
               <lb n="4" xml:id="trl-p2-l4"/>spʾlk'
               <lb n="5" xml:id="trl-p2-l5"/>K-#II
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0076_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Dādēnwindād ēn
               <lb n="2" xml:id="trc-p1-l2"/>Day pad Mihr
               <lb n="3" xml:id="trc-p1-l3"/>ǰaw k(abīz) 2 asp
               <lb n="4" xml:id="trc-p1-l4"/>(ān ī) syārān
               <lb n="5" xml:id="trc-p1-l5"/>dād
               <lb n="6" xml:id="trc-p1-l6"/>rōz Mihr
               <lb n="7" xml:id="trc-p1-l7"/>spārag
               <lb n="8" xml:id="trc-p1-l8"/>astar ī
               <lb n="9" xml:id="trc-p1-l9"/>Ādurdād ārd (?)[
               <lb n="10" xml:id="trc-p1-l10"/>ǰaw k(abīz) 1
               <lb n="11" xml:id="trc-p1-l11"/>wahāg...
            </ab>
            <ab xml:id="MP0076_trc-p2">
               <addSpan place="top" spanTo="#trc-p2-l5" style="writing-mode: sideways-rl"/>
               <lb n="1" xml:id="trc-p2-l1"/>asp ī
               <lb n="2" xml:id="trc-p2-l2"/>Farroxzād
               <lb n="3" xml:id="trc-p2-l3"/>rōz Mihr
               <lb n="4" xml:id="trc-p2-l4"/>spārag
               <lb n="5" xml:id="trc-p2-l5"/>k(abīz) 2
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0076_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dādēnwindād this
               <lb n="2" xml:id="trans-p1-l2"/>(day) Day pad Mihr (15th day)
               <lb n="3" xml:id="trans-p1-l3"/>2 kabīz of barley horse
               <lb n="4" xml:id="trans-p1-l4"/>that one with black legs
               <lb n="5" xml:id="trans-p1-l5"/>is to give
               <lb n="6" xml:id="trans-p1-l6"/>(and) day Mihr (16th day)
               <lb n="7" xml:id="trans-p1-l7"/>(actually) binding
               <lb n="8" xml:id="trans-p1-l8"/>mule of
               <lb n="9" xml:id="trans-p1-l9"/>Ādurdād flour (?)
               <lb n="10" xml:id="trans-p1-l10"/>1 kabīz of barley
               <lb n="11" xml:id="trans-p1-l11"/>and .... 
            </ab>
            <ab xml:id="MP0076_trans-p2">
               <addSpan place="top" spanTo="#trans-p2-l5" style="writing-mode: sideways-rl"/>
               <lb n="1" xml:id="trans-p2-l1"/>Horse of
               <lb n="2" xml:id="trans-p2-l2"/>Farroxzād
               <lb n="3" xml:id="trans-p2-l3"/>on day Mihr (16th day)
               <lb n="4" xml:id="trans-p2-l4"/>(actually) binding
               <lb n="5" xml:id="trans-p2-l5"/>2 kabīz.
            </ab>
         </div>
      </body>
   </text>
</TEI>