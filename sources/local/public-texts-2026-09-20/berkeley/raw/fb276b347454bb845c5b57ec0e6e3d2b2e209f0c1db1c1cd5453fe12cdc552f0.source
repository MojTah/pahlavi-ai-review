   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0423_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>MKḆLWNm mṭrpnʾh Y pṭˈ
               <lb n="2" xml:id="trl-p1-l2"/>sṭpsṭʾn dʾlyk ......
               <lb n="3" xml:id="trl-p1-l3"/>plhwṭl ʾwsṭʾndʾl lʾd MN
               <lb n="4" xml:id="trl-p1-l4"/>zʾṭʾnplhwˈ Y pyšynykˈ(?)
               <lb n="5" xml:id="trl-p1-l5"/>dʾlyk ......... ḤS-$$(?) dwlkˈ
               <lb n="6" xml:id="trl-p1-l6"/>BYRḤ mṭrˈ Y ŠNṬ $-III-III
               <lb n="7" xml:id="trl-p1-l7"/>W YWM zʾmdʾṭˈ ......
               <lb n="8" xml:id="trl-p1-l8"/>◯ $X-III-III dwlkˈ p(ʾ)ṭglʾḇ
               <lb n="9" xml:id="trl-p1-l9"/>pṭˈ gwkʾdy-mwdlʾn Y
               <lb n="10" xml:id="trl-p1-l10"/> mʾhp̄ylwcˈ ḤTYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0423_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>padīrēm Mihrpanāh ī pad
               <lb n="2" xml:id="trc-p1-l2"/>Stabestān dārīg ......
               <lb n="3" xml:id="trc-p1-l3"/>farroxtar ōstāndār rāy az
               <lb n="4" xml:id="trc-p1-l4"/>Zādānfarrox ī pēšēnīg(?)
               <lb n="5" xml:id="trc-p1-l5"/>dārīg ......... may-40(?) dōlag
               <lb n="6" xml:id="trc-p1-l6"/>māh Mihr ī sāl 46
               <lb n="7" xml:id="trc-p1-l7"/>ud rōz Zāmyād ......
               <lb n="8" xml:id="trc-p1-l8"/>◯ 36 dōlag pā̂dīrāy
               <lb n="9" xml:id="trc-p1-l9"/>pad gugāy-muhrān ī
               <lb n="10" xml:id="trc-p1-l10"/>Māh-Pērōz āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0423_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Ich erhalte, Mihrpanāh der in
               <lb n="2" xml:id="trans-p1-l2"/>Stabestān(?) Verwalter ......
               <lb n="3" xml:id="trans-p1-l3"/>wegen des sehr glücklichen ōstāndār von
               <lb n="4" xml:id="trans-p1-l4"/>Zādānfarrox, dem früheren(?)
               <lb n="5" xml:id="trans-p1-l5"/>Verwalter ...... Wein 40(?) Eimer
               <lb n="6" xml:id="trans-p1-l6"/>Monat Mihr (7. Monat) des Jahres 46 (677/678 n. Chr.)
               <lb n="7" xml:id="trans-p1-l7"/>und Tag Zāmyād (28.Tag) ......
               <lb n="8" xml:id="trans-p1-l8"/>36 Eimer: Die Empfangsbestätigung (= die Empfangsbestätigung über 36 Eimer)
               <lb n="9" xml:id="trans-p1-l9"/>(ist) mit den Zeugen-Siegeln des
               <lb n="10" xml:id="trans-p1-l10"/>Māh-Pērōz gesiegelt.
            </ab>
         </div>
      </body>
   </text>
</TEI>