   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85218-5.recto_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0005_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>plykˈ Y pṭ' nmṭl
               <lb n="2" xml:id="trl-p1-l2"/>dʾlyk ẔNH BYRḤ mṭr' Y 
               <lb n="3" xml:id="trl-p1-l3"/>ŠNṬ$ X-IIII-III MN ẔK Y MN 
               <lb n="4" xml:id="trl-p1-l4"/>ml Y plhwṭl ʾwsṭʾndʾl ʿL 
               <lb n="5" xml:id="trl-p1-l5"/>bwn' ṬBNʾ-I pṭmʾn ʿL 
               <lb n="6" xml:id="trl-p1-l6"/>mʾhplhw' Y NYŠH Y pylwcʾn 
               <lb n="7" xml:id="trl-p1-l7"/>YḤBWNṭ' yaspʾṭʾl 
               <lb n="8" xml:id="trl-p1-l8"/>ḤṬYMWNṭ </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0005_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Friyag ī pad Namtar 
               <lb n="2" xml:id="trc-p1-l2"/>dārīg ēn māh Mihr ī 
               <lb n="3" xml:id="trc-p1-l3"/>sāl 37 az ān ī az 
               <lb n="4" xml:id="trc-p1-l4"/>mar ī farroxtar ōstāndār ō 
               <lb n="5" xml:id="trc-p1-l5"/>bun kāh 1 paymān ō 
               <lb n="6" xml:id="trc-p1-l6"/>Māhfarrox ī zan ī Pērōzān 
               <lb n="7" xml:id="trc-p1-l7"/>dād Yasnpādār 
               <lb n="8" xml:id="trc-p1-l8"/>āwišt </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0005_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Friyag, der in Namtar 
               <lb n="2" xml:id="trans-p1-l2"/>Verwalter (ist), diesen Monat Mihr des 
               <lb n="3" xml:id="trans-p1-l3"/>Jahres 37, von ihm aus 
               <lb n="4" xml:id="trans-p1-l4"/>dem besitz des überaus glücklichen ōstāndār zur 
               <lb n="5" xml:id="trans-p1-l5"/>„Zentrale“: Stroh, 1 Maß, der 
               <lb n="6" xml:id="trans-p1-l6"/>Māhfarrox, der Frau des Pērōzān
               <lb n="7" xml:id="trans-p1-l7"/>gegeben. Der Yasnpādār 
               <lb n="8" xml:id="trans-p1-l8"/>(hat das Dokument) gesiegelt. </ab>
         </div>
      </body>
   </text>
</TEI>