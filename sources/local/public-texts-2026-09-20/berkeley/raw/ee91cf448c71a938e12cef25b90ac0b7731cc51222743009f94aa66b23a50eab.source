   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0438_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ẔNH BYRḤ mṭrˈ Y ŠNṬ
               <lb n="2" xml:id="trl-p1-l2"/>$X-IIII MKḆLWNm mṭlwdy
               <lb n="3" xml:id="trl-p1-l3"/>Y dlcyk mwckˈ Y yʾmykˈ
               <lb n="4" xml:id="trl-p1-l4"/>W MN BYRḤ prwrṭynˈ Y
               4bis W KRʾ
               <lb n="5" xml:id="trl-p1-l5"/>hm ŠNṬ $X-IIII lʾd MN
               <lb n="6" xml:id="trl-p1-l6"/>dyn-...(?) NKSYʾ
               <lb n="7" xml:id="trl-p1-l7"/>S-IIII W p(ʾ)ṭglʾḇ
               <lb n="8" xml:id="trl-p1-l8"/>mṭlwdy pṭˈ
               <lb n="9" xml:id="trl-p1-l9"/>{gwk}ʾymwdlyhʾ {Y}
               <lb n="10" xml:id="trl-p1-l10"/>pylwcmṭr Y
               <lb n="11" xml:id="trl-p1-l11"/>pyšynykˈ(?)
               <lb n="12" xml:id="trl-p1-l12"/>ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0438_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>ēn māh Mihr ī sāl
               <lb n="2" xml:id="trc-p1-l2"/>34 padīrēm Mihrōy
               <lb n="3" xml:id="trc-p1-l3"/>ī darzīg mōzag ī ǰāmīg
               <lb n="4" xml:id="trc-p1-l4"/>ud az māh Frawardīn ī
               4bis ud harw
               <lb n="5" xml:id="trc-p1-l5"/>ham sāl 34 rāy az
               <lb n="6" xml:id="trc-p1-l6"/>Dēn-...(?) xwāstag
               <lb n="7" xml:id="trc-p1-l7"/>satēr-4 ud pā̂dīrāy
               <lb n="8" xml:id="trc-p1-l8"/>Mihrōy pad
               <lb n="9" xml:id="trc-p1-l9"/>{gug}āy-muhrīhā {ī}
               <lb n="10" xml:id="trc-p1-l10"/>Pērōz-Mihr ī
               <lb n="11" xml:id="trc-p1-l11"/>pēšēnīg(?)
               <lb n="12" xml:id="trc-p1-l12"/>āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0438_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Diesen Monat Mihr (7.Monat) des Jahres
               <lb n="2" xml:id="trans-p1-l2"/>34 erhalte ich, Mihrōy,
               <lb n="3" xml:id="trans-p1-l3"/>der Schneider, Schuh(e) aus ...(?)
               <lb n="4" xml:id="trans-p1-l4"/>Und vom Monat Frawardīn (1. Monat) an
            [4bis] und (zwar) alle (= jeden Monat)
               <lb n="5" xml:id="trans-p1-l5"/>desselben Jahres 34 von
               <lb n="6" xml:id="trans-p1-l6"/>Dēn-...(?) Vergütung
               <lb n="7" xml:id="trans-p1-l7"/>(im Werte von) Satēr 4. Die Empfangsbestätigung
               <lb n="8" xml:id="trans-p1-l8"/>(hat) Mihrōy mit
               <lb n="9" xml:id="trans-p1-l9"/>{Ze}gen-Siegeln (des)
               <lb n="10" xml:id="trans-p1-l10"/>Pērōz-Mihrōy, des
               <lb n="12" xml:id="trans-p1-l11"/>früheren(?),
               <lb n="13" xml:id="trans-p1-l12"/>versiegelt.
            </ab>
         </div>
      </body>
   </text>
</TEI>