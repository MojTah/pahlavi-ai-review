   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0434_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>]wʾṭ hwslwy pṭˈ nʾmkˈ
               <lb n="2" xml:id="trl-p1-l2"/>]...ʾl dʾṭwblyh pṭˈ
               <lb n="3" xml:id="trl-p1-l3"/>]...-wlkˈ(?) Y mʾhd(ʾ)ṭwyhʾn(?)
               <lb n="4" xml:id="trl-p1-l4"/>[MN YW]M ʾsmʾn prʾc ʿD
               <lb n="5" xml:id="trl-p1-l5"/>[YWM ]ʾmwrdṭ Y BYRḤ ʾp̄ʾn
               <lb n="6" xml:id="trl-p1-l6"/>pṭˈ III-III-III YWM lwcyk
               <lb n="7" xml:id="trl-p1-l7"/>](III)-III BSLYʾ-IIII
               <lb n="8" xml:id="trl-p1-l8"/>[klṭk W(?) Ḥ]S-IIII dwlkˈ
               <lb n="9" xml:id="trl-p1-l9"/>](l.) ...
               <lb n="10" xml:id="trl-p1-l10"/>](.)
            </ab>
            <ab xml:id="MP0434_trl-p2">
               <lb n="1" xml:id="trl-p12-l1"/>]... lʾn(?)
               <lb n="2" xml:id="trl-p12-l2"/>ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0434_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>]-wād Xusrōy pad nāmag
               <lb n="2" xml:id="trc-p1-l2"/>]...-ār dādwarīh pad
               <lb n="3" xml:id="trc-p1-l3"/>]...-Warrag(?) ī Māhdād-Wehān(?)
               <lb n="4" xml:id="trc-p1-l4"/>[az rō]z Asmān frāz tā
               <lb n="5" xml:id="trc-p1-l5"/>[rōz ]Amurdād ī māh Ābān
               <lb n="6" xml:id="trc-p1-l6"/>pad 9 rōz rōzīg
               <lb n="7" xml:id="trc-p1-l7"/>]-3 gōšt-4
               <lb n="8" xml:id="trc-p1-l8"/>[kardag ud(?) m]ay-4 dōlag
               <lb n="9" xml:id="trc-p1-l9"/>]......
               <lb n="10" xml:id="trc-p1-l10"/>](.)
            </ab>
            <ab xml:id="MP0434_trc-p2">
               <lb n="1" xml:id="trc-p2-l1"/>]...
               <lb n="2" xml:id="trc-p2-l2"/>āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0434_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>... Xusrōy in einem Brief
               <lb n="2" xml:id="trans-p1-l2"/>...... eine Entscheidung/ein Urteil für
               <lb n="3" xml:id="trans-p1-l3"/>... ‐Warrag, Sohn des Māhdād-Weh(?),
               <lb n="4" xml:id="trans-p1-l4"/>[vom Ta]ge Asmān (27.Tag) bis zum
               <lb n="5" xml:id="trans-p1-l5"/>[Tage ]Amurdād (7. Tag) des Monats Ābān (8.Monat)
               <lb n="6" xml:id="trans-p1-l6"/>für 9 Tage Ration
               <lb n="7" xml:id="trans-p1-l7"/>... ] ... Fleisch 4
               <lb n="8" xml:id="trans-p1-l8"/>[Portionen und(?) ]Wein: 4 Eimer
               <lb n="9" xml:id="trans-p1-l9"/>...... ] ... –
            </ab>
            <ab xml:id="MP0434_trans-p2">
               <lb n="1" xml:id="trans-p2-l1"/>...
               <lb n="2" xml:id="trans-p2-l2"/>gesiegelt.
            </ab>
         </div>
      </body>
   </text>
