         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="local:"-->
            <ab xml:id="MP5253_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>wcʾlšn' Y (dʾšt)?
               <lb n="2" xml:id="trl-p1-l2"/>MN plhwdwšk' ŠNṬ
               <lb n="3" xml:id="trl-p1-l3"/>$$$$ III BYRḤ
               <lb n="4" xml:id="trl-p1-l4"/>ṭ(y)l W YWM ʾṭwr'
               <lb n="5" xml:id="trl-p1-l5"/>kpyc'
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP5253_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>wizārišn ī (dāšt)?
               <lb n="2" xml:id="trc-p1-l2"/>az Farroxdōšag sāl
               <lb n="3" xml:id="trc-p1-l3"/>83 māh
               <lb n="4" xml:id="trc-p1-l4"/>Tīr ud rōz Ādur
               <lb n="5" xml:id="trc-p1-l5"/>kabiz?
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP5253_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Erhaltene Entscheidung
               <lb n="2" xml:id="trans-p1-l2"/>von Farroxdōšag. Jahr
               <lb n="3" xml:id="trans-p1-l3"/>80, Monat
               <lb n="4" xml:id="trans-p1-l4"/>Tīr (4. Monat) und Tag Ādur (9. Tag)
               <lb n="5" xml:id="trans-p1-l5"/>Kabīz?
            </ab>
         </div>
