               <lb n="9" xml:id="trl-p1-l9"/>MN ZK hsp̄ynlcˈ MṬʾ PWN sṭhm W hlwsṭˈ NYŠH ḤD *dycʾy
               <lb n="10" xml:id="trl-p1-l10"/>ŠM Y pʾṭhšʾdyhʾ bwlcyn-pylwcˈ NYŠH MN tnˈ pylʾykˈ W yʾmkˈ
               <lb n="11" xml:id="trl-p1-l11"/>W dwcyṭkˈ Y PWN mškˈ KSP̄ˈ S-III-II-C KḤDH QDM ŠRYṬWNtny
               <lb n="12" xml:id="trl-p1-l12"/>W YḤNCLWNtny gywʾk gywʾk W ZK ʾyʾlkyhʾ PWN ʾywkˈ Y ʾYŠ zʾdsṭnˈ
               <lb n="13" xml:id="trl-p1-l13"/>BRʾ ḤT QDM ZK CBW plmwṭ GBRʾ GBRʾ BʿYḤWNsṭnˈ W PWN
               <lb n="14" xml:id="trl-p1-l14"/>ʾp̄ymwsṭyh Y bwlcyn-pylwcˈ wcyl W dʾṭwblyh krṭnˈ MN L ʿL MRʿḤ
               <lb n="15" xml:id="trl-p1-l15"/>nʾmkˈ YḤWWNyt ʾynyʾ bwlcyn-pylwc ʿL ʾp̄ymwsṭyh mṭnˈ Lʾ
               <lb n="16" xml:id="trl-p1-l16"/>sʾhṭnˈ W mwsṭˈ YḤWWNṭˈ W PWN ZK (M)NDʿM plmʾn YḤBWNṭˈ L ʿYNˈ L (p)shwˈ
               <lb n="17" xml:id="trl-p1-l17"/>ḤT ʾYTˈ ẔNH MDNʿM ʾyṭwnˈ cygwn bwlcyn-pylwcˈ glcyṭ PWN ZK
               <lb n="18" xml:id="trl-p1-l18"/>W ʿLH-šʾn GBRʾ ʾyṭwnˈ prʾc ŠḎṞWNtny Lʾ scytˈ ◯ MRʿḤ
               <lb n="19" xml:id="trl-p1-l19"/>cygwn bwlcyn-pylwcˈ PWN ẔK ʾdwynkˈ glcyt ḤNʾ-CBW lʾd dʾṭgwšnsp̄ˈ
               <lb n="20" xml:id="trl-p1-l20"/>W ʿLH-šʾn GBRʾ BRʾ bwṭnˈ W MRYʾ hc-š ʿŠMHNṭ (YKʿYMWNʾṭ) MNʿDM gwwcʾl
