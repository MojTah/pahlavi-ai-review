   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb n="1" xml:id="pb-1r-trl"/><!--facs="local:"-->
            <ab xml:id="MP3584_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>mʾṭykwlk ḤG G-III-III-III
               <lb n="2" xml:id="trl-p1-l2"/>msʾp̄ʾt ḤG G-III-III-III
               <lb n="3" xml:id="trl-p1-l3"/>(wʾs)pwhl ḤG G-III-III-III
               <lb n="4" xml:id="trl-p1-l4"/>wzlykwl ḤG G-III-III-III
               <lb n="5" xml:id="trl-p1-l5"/>(yʾt) hʾwšṭ' [lʾd] ḤG G-III ○○○
            </ab>
            <pb n="2" xml:id="pb-1v-trl"/><!--facs="local:"-->
            <ab xml:id="MP3584_trl-p2">
               <lb n="1" xml:id="trl-p2-l1"/>[ḤG] ḤG G-III-III-III ○ myckʾwst' ḤG
               <lb n="2" xml:id="trl-p2-l2"/>ḤG G-III-III-III ○ ʾp̄zng ḤG G-III-III-III
               <lb n="3" xml:id="trl-p2-l3"/>[○ h]šṭʾṭzwlk' ḤG G-III-III-III
               <lb n="4" xml:id="trl-p2-l4"/>[○] (d)ckdyṭn' ysk kʾl ḤG G-III-III-III
               <lb n="5" xml:id="trl-p2-l5"/>[○] wlgʾp̄ʾt' ḤG G-IIII-III ○ ʾnwš
               <lb n="6" xml:id="trl-p2-l6"/>[Ḥ]G G-III --III-III ○○ ...--
               <lb n="7" xml:id="trl-p2-l7"/>--G-IIII-III-- 
            </ab>
         </div>
<!--          <div type="transcription" xml:lang="pal">
            <ab xml:id="MP3584_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Transcription not published
            </ab>
         </div> -->
         <div type="translation" xml:lang="en">
            <ab xml:id="MP3584_trans-p1">              
               <lb n="1" xml:id="trans-p1-l1"/>For the ewe lamb (breeding station) 9 grīw of wheat.
               <lb n="2" xml:id="trans-p1-l2"/>For the retirement camp 9 grīw of wheat.
               <lb n="3" xml:id="trans-p1-l3"/>A principal 9 grīw of wheat.
               <lb n="4" xml:id="trans-p1-l4"/>A cosh-bearer 9 grīw of wheat
               <lb n="5" xml:id="trans-p1-l5"/>A portion of 3 grīw of wheat on behalf of the apprentices.
            </ab>
               <ab xml:id="MP3584_trans-p2">
               <lb n="1" xml:id="trans-p2-l1"/>9 grīw of [wheat]. The taster
               <lb n="2" xml:id="trans-p2-l2"/>9 grīw of what. (The workers of) the water-canal 9 grīw of wheat.
               <lb n="3" xml:id="trans-p2-l3"/>An officer of a troop of eighty (a "centurio") 9 grīw of wheat.
               <lb n="4" xml:id="trans-p2-l4"/>The treatment of eye disease (trachoma) 9 grīw of wheat.
               <lb n="5" xml:id="trans-p2-l5"/>The repository of papyri 7 grīw of wheat. For (the supply of) antidote
               <lb n="6" xml:id="trans-p2-l6"/>3 grīw of [wh]eat... ....
               <lb n="7" xml:id="trans-p2-l7"/>...
            </ab>
         </div>
      </body>
   </text>
