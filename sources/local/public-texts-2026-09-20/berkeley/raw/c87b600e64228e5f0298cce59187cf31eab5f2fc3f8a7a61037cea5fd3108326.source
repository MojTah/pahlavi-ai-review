         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/>
            <ab xml:id="MP0501_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>dʾṭlwy ẔNH BYRḤ ʾp̄ʾn
               [Y über ŠNṬ geschrieben]
               <lb n="2" xml:id="trl-p1-l2"/>ŠNṬ $X-III-III lwcyk
               <lb n="3" xml:id="trl-p1-l3"/>lʾd grmkˈ G-III ◯
               <lb n="4" xml:id="trl-p1-l4"/>ʿL pyṭˈ YḤBWNṭˈ
               <lb n="5" xml:id="trl-p1-l5"/>ckˈ dyn-...
               <lb n="6" xml:id="trl-p1-l6"/>ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0501_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Dādrōy ēn māh Ābān
               <lb n="2" xml:id="trc-p1-l2"/>ī sāl 36 rōzīg
               <lb n="3" xml:id="trc-p1-l3"/>rāy garmak grīw-3 ◯
               <lb n="4" xml:id="trc-p1-l4"/>ō pid dād
               <lb n="5" xml:id="trc-p1-l5"/>čak Dēn-...
               <lb n="6" xml:id="trc-p1-l6"/>āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0501_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dādrōy: Diesen Monat Ābān (8. Monat)
               <lb n="2" xml:id="trans-p1-l2"/>des Jahres 36 (667/668 n. Chr.) der Ration
               <lb n="3" xml:id="trans-p1-l3"/>wegen Melonen 3 grīw
               <lb n="4" xml:id="trans-p1-l4"/>dem Vater gegeben.
               <lb n="5" xml:id="trans-p1-l5"/>Den Scheck (hat) Dēn‐...
               <lb n="6" xml:id="trans-p1-l6"/>gesiegelt.
            </ab>
         </div>
