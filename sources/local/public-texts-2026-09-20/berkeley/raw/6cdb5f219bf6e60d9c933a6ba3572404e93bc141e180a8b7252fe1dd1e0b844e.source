   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!-- Add later facs="LA:UNKNOWN" -->
            <ab xml:id="MP0455_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ʿ(L)(?) ..................... ʾclmykṭwm
               <lb n="2" xml:id="trl-p1-l2"/>ʾḤY MN *wnˈ <persName ref="people:CIr018">gwšnsp̄ˈ</persName> hmʾy .........
               <lb n="3" xml:id="trl-p1-l3"/>....................................... ◯
               <lb n="4" xml:id="trl-p1-l4"/>L ḤNʾ ... ẔNH plhwˈ ......
               <lb n="5" xml:id="trl-p1-l5"/>drwysṭyh Y ...15 ...... ...... ḆYN
               <lb n="6" xml:id="trl-p1-l6"/>pwsṭ ʿL ...... p(ʾ)ṭylʾḇ(?) ḤNʾ GBRʾ
               <lb n="7" xml:id="trl-p1-l7"/>...16 ......... ʾlcʾnyk plmʾyt
               <lb n="8" xml:id="trl-p1-l8"/>ŠDRWNṭnˈ(?) ......... lʾd QDM
               <lb n="9" xml:id="trl-p1-l9"/>ʾclmyk ʾḤY Y MN ...............
               <lb n="10" xml:id="trl-p1-l10"/>ḆYN .........ckˈ(?) lʾd p-... ʿL L ʾy  plmʾyt
               <lb n="11" xml:id="trl-p1-l11"/>YNSḆWNṭn MRʿḤ Y LK ............ pṭˈ lʾmšnˈ
               <lb n="12" xml:id="trl-p1-l12"/>ʾy YḤWWNyṭ pṭˈ ŠRM W ʾlyn ʾMṬ ẔK LʿYN YḤWWNyṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0455_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>ō(?) ..................... āzarmīgtom
               <lb n="2" xml:id="trc-p1-l2"/>brād az whmān <persName ref="people:CIr018">Gušnasp</persName> hamē
               <lb n="3" xml:id="trc-p1-l3"/>....................................... ◯
               <lb n="4" xml:id="trc-p1-l4"/>man ēd ... ēn farrox ......
               <lb n="5" xml:id="trc-p1-l5"/>drustīh ī ... ...... ...... andar
               <lb n="6" xml:id="trc-p1-l6"/>pōst ō ...... padirāy(?) ēd mard
               <lb n="7" xml:id="trc-p1-l7"/>............ arzānīg framāyēd
               <lb n="8" xml:id="trc-p1-l8"/>frēstādan(?) ......... rāy abar
               <lb n="9" xml:id="trc-p1-l9"/>āzarmīg brād ī m-//////
               <lb n="10" xml:id="trc-p1-l10"/>andar .........čak(?) rāy ... ō man ē framāyēd
               <lb n="11" xml:id="trc-p1-l11"/>stadan xwadāy ī tō ............ pad rāmišn
               <lb n="12" xml:id="trc-p1-l12"/>ē bawēd pad drōd ud āfrīn ka ān pēš bawēd
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0455_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dem(?) ...... verehrtesten
               <lb n="2" xml:id="trans-p1-l2"/>Bruder von einem gewissen Gušnasp immer
               <lb n="3-8" xml:id="trans-p1-l3-8"/>... [4] ... [5] ... [6] ... [7] ... [8] ...
               <lb n="9" xml:id="trans-p1-l9"/>verehrter Bruder des ...... wegen über
               <lb n="10" xml:id="trans-p1-l10"/>......... mir soll er auftragen
               <lb n="11" xml:id="trans-p1-l11"/>zu nehmen ......... in Frieden
               <lb n="12" xml:id="trans-p1-l12"/>soll (er) sein, in Gesundheit und Segen, wie er (es schon) vorher ist.
            </ab>
         </div>
      </body>
   </text>
