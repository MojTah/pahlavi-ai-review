   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0409_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ʾsp̄pʾṭˈ ẔNH BYRḤ
               <lb n="2" xml:id="trl-p1-l2"/>sp̄ndrmṭ Y ŠNṬ $X-III
               <lb n="3" xml:id="trl-p1-l3"/>lwcyk Y BYRḤ whwmnˈ
               <lb n="4" xml:id="trl-p1-l4"/>BYRḤ sp̄ndrmṭ Y hm
               <lb n="5" xml:id="trl-p1-l5"/>ŠNṬ $X-III BYRḤ
               <lb n="6" xml:id="trl-p1-l6"/>prwrṭynˈ Y ŠNṬ
               <lb n="7" xml:id="trl-p1-l7"/>$-X-IIII ʾMYṭl
               <lb n="8" xml:id="trl-p1-l8"/>Y plhwzʾṭˈ lʾd
               <lb n="9" xml:id="trl-p1-l9"/>ḤG ○ G-III-III [Y hwlšnˈ]
               <lb n="10" xml:id="trl-p1-l10"/>cygwn ḤWHyt
               <lb n="11" xml:id="trl-p1-l11"/>lʾd dwš(ʾl)m ʿL
               <lb n="12" xml:id="trl-p1-l12"/>plsṭʾl Y
               <lb n="13" xml:id="trl-p1-l13"/>ʾMYṭl Y plhwzʾṭˈ
               <lb n="14" xml:id="trl-p1-l14"/>YḤBWNṭˈ dʾṭynpnʾh
               <lb n="15" xml:id="trl-p1-l15"/>ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0409_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Aspbād ēn māh
               <lb n="2" xml:id="trc-p1-l2"/>Spandarmad ī sāl 33
               <lb n="3" xml:id="trc-p1-l3"/>rōzīg ī māh Wahman
               <lb n="4" xml:id="trc-p1-l4"/>māh Spandarmad ī ham
               <lb n="5" xml:id="trc-p1-l5"/>sāl 33 māh
               <lb n="6" xml:id="trc-p1-l6"/>Frawardīn ī sāl
               <lb n="7" xml:id="trc-p1-l7"/>34 mādar
               <lb n="8" xml:id="trc-p1-l8"/>ī Farroxzād rāy
               <lb n="9" xml:id="trc-p1-l9"/>gandum ○ grīw 6 [ī xwarišn]
               <lb n="10" xml:id="trc-p1-l10"/>čiyōn hēd
               <lb n="11" xml:id="trc-p1-l11"/>rāy dōš(ār)am ō
               <lb n="12" xml:id="trc-p1-l12"/>paristār ī
               <lb n="13" xml:id="trc-p1-l13"/>mādar ī Farroxzād
               <lb n="14" xml:id="trc-p1-l14"/>dād Dādēnpanāh
               <lb n="15" xml:id="trc-p1-l15"/>āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0409_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Aspbād this month
               <lb n="2" xml:id="trans-p1-l2"/>Spandarmad (12th month) of year 33
               <lb n="3" xml:id="trans-p1-l3"/>gave on behalf of the rations of month Wahman (11th month) and
               <lb n="4" xml:id="trans-p1-l4"/>month Spandarmad (12th month) of the same
               <lb n="5" xml:id="trans-p1-l5"/>year 33 [and] month
               <lb n="6" xml:id="trans-p1-l6"/>Frawardīn (1st month) of year
               <lb n="7" xml:id="trans-p1-l7"/>34 for the mother
               <lb n="8" xml:id="trans-p1-l8"/>of Farroxzād
               <lb n="9" xml:id="trans-p1-l9"/>6 grīw of wheat [as food]
               <lb n="10-11" xml:id="trans-p1-l10-11"/>kindly (in love)—as is right and proper—to
               <lb n="12" xml:id="trans-p1-l12"/>the maidservant of the
               <lb n="13" xml:id="trans-p1-l13"/>mother of Farroxzād
               <lb n="14" xml:id="trans-p1-l14"/>given. Dādēnpanāh
               <lb n="15" xml:id="trans-p1-l15"/>sealed (it).
            </ab>
         </div>
      </body>
   </text>
</TEI>