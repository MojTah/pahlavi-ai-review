   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
             <pb xml:id="pb-1r-trl"/><!--facs="local:"-->
            <ab xml:id="MP2151_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>.... [n]ʾmk['?
               <lb n="2" xml:id="trl-p1-l2"/>wsy ... ylyh W pṭ' ʾp̄ʾyšn' kl?
               <lb n="3" xml:id="trl-p1-l3"/>W ʾytwn' dʾšt' YḤWWNʾt
               <lb n="4" xml:id="trl-p1-l4"/>W ZK ʾwbš YḤMṬWNʾṭ Y
               <lb n="5" xml:id="trl-p1-l5"/>dʾšn'? LKWM W L pṭ' KRʾ
               <lb n="6" xml:id="trl-p1-l6"/>]l.l.[]...l l
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP2151_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>n]āmag[?
               <lb n="2" xml:id="trc-p1-l2"/>wisē ... ... ud pad abāyišngar?
               <lb n="3" xml:id="trc-p1-l3"/>ud ēdōn dāšt bawād
               <lb n="4" xml:id="trc-p1-l4"/>ud ān awiš āyād ī?
               <lb n="5" xml:id="trc-p1-l5"/>dāšn? ašmā ud man pad harw
               <lb n="6" xml:id="trc-p1-l6"/>... ... ... ...
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP2151_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>B]rief?
               <lb n="2" xml:id="trans-p1-l2"/>Versand-... ... und mit ... ...
               <lb n="3" xml:id="trans-p1-l3"/>und soll empfangen werden,
               <lb n="4" xml:id="trans-p1-l4"/>und dazu/zu ihm soll kommen, was?
               <lb n="5" xml:id="trans-p1-l5"/>(an) Gabe/Geschenk Ihr und ich für alle(s)?
               <lb n="6" xml:id="trans-p1-l6"/>... ... ... …
            </ab>
         </div>
      </body>
   </text>
</TEI>