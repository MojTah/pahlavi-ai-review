   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/>
            <ab xml:id="MP0502_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>MKḆLWNm plʾdy ẔNH
               <lb n="2" xml:id="trl-p1-l2"/>BYRḤ ʾrṭwhšṭ Y ŠNṬ $X-II
               <lb n="3" xml:id="trl-p1-l3"/>ʾwcynšn Y dwṭkˈ Y ʾwsṭʾndʾl
               <lb n="4" xml:id="trl-p1-l4"/>pṭˈ ḤG III-II lʾd MN
               <lb n="5" xml:id="trl-p1-l5"/>mṭlwdy Y hwslwdʾn ...
               <lb n="6" xml:id="trl-p1-l6"/>.........G-X ◯
               <lb n="7" xml:id="trl-p1-l7"/>W ẔNH p(ʾ)ṭglʾḇ plʾdy
               <lb n="8" xml:id="trl-p1-l8"/>ḤṬYMWNṭ ◯◯
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0502_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>padīrēm Frāy ēn
               <lb n="2" xml:id="trc-p1-l2"/>māh Ardwahišt ī sāl 32
               <lb n="3" xml:id="trc-p1-l3"/>uzēnišn ī dūdag ī ōstāndār
               <lb n="4" xml:id="trc-p1-l4"/>pad gandum 5 rāy az
               <lb n="5" xml:id="trc-p1-l5"/>Mihrōy ī Xusrōyān ...
               <lb n="6" xml:id="trc-p1-l6"/>...... ... grīw 10 ◯
               <lb n="7" xml:id="trc-p1-l7"/>ud ēn pā̂dīrāy Frāy
               <lb n="8" xml:id="trc-p1-l8"/>āwišt ◯◯
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0502_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Ich, Frāy, erhalte diesen
               <lb n="2" xml:id="trans-p1-l2"/>Monat Ardwahišt (2. Monat) des Jahres 32
               <lb n="3" xml:id="trans-p1-l3"/>der Ausgaben der Familie des ōstāndār
               <lb n="4" xml:id="trans-p1-l4"/>über Weizen: 5 (Einheiten?) wegen von
               <lb n="5" xml:id="trans-p1-l5"/>Mihrōy, (Sohn) des Xusrō, ...
               <lb n="6" xml:id="trans-p1-l6"/>...... ......
               <lb n="7" xml:id="trans-p1-l7"/>Und diese Empfangsbestätigung (hat) Frāy
               <lb n="8" xml:id="trans-p1-l8"/>gesiegelt.
            </ab>
         </div>
      </body>
   </text>
</TEI>