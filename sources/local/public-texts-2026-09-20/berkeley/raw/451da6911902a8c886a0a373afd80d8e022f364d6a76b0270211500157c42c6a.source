   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/>
            <ab xml:id="MP2500_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>(seulement le bas des caractères)
               <lb n="2" xml:id="trl-p1-l2"/>(...) yt' o yẕdʾn-(...?) [
               <lb n="3" xml:id="trl-p1-l3"/>ʾkʾsyh mt' 4 blbl YHB[WNt ?]//GBRʾ-I [
               <lb n="4" xml:id="trl-p1-l4"/>Y-š MLKʾn MLKʾ bndkyh kltn'
               <lb n="5" xml:id="trl-p1-l5"/>Iʾd ʿL ʾkʾsyh (...) [
               <lb n="6" xml:id="trl-p1-l6"/>ZK blbl ʿL (...) [
               <lb n="7" xml:id="trl-p1-l7"/>(...) MN(...)[
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP2500_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>(.)
               <lb n="2" xml:id="trc-p1-l2"/>(...)yt' o Yazdān-(?...) |
               <lb n="3" xml:id="trc-p1-l3"/>āgāhīh mad barbar (dād)//mard-I|
               <lb n="4" xml:id="trc-p1-l4"/>ī-š šāhān šāh bandagīh kardan
               <lb n="5" xml:id="trc-p1-l5"/>rāy ō āgāhīh (...) [
               <lb n="6" xml:id="trc-p1-l6"/>ān barbar ō (...) [
               <lb n="7" xml:id="trc-p1-l7"/>(...) az (...) [
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP2500_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>...
               <lb n="2" xml:id="trans-p1-l2"/>...
               <lb n="3" xml:id="trans-p1-l3"/>information came regarding one βάρβαρος-man
               <lb n="4" xml:id="trans-p1-l4"/>whom the King of Kings is about to make his (own) slave
               <lb n="5" xml:id="trans-p1-l5"/>for information 
               <lb n="6" xml:id="trans-p1-l6"/>the βάρβαρος to
               <lb n="7" xml:id="trans-p1-l7"/>... from ...
               
            </ab>
         </div>
      </body>
   </text>
