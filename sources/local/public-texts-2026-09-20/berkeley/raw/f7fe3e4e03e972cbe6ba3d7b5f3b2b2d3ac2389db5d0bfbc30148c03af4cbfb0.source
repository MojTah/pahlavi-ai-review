   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0414_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ʾsp̄pʾṭˈ MN ẔK Y
               <lb n="2" xml:id="trl-p1-l2"/>ʿL bwnˈ ẔNH sp̄ndrmṭˈ
               <lb n="3" xml:id="trl-p1-l3"/>Y ŠNṬ $X-IIII lwcyk Y
               <lb n="4" xml:id="trl-p1-l4"/>BYRḤ whwmnˈ W BYRḤ
               <lb n="5" xml:id="trl-p1-l5"/>sp̄ndrmṭ lʾd ḤG
               <lb n="6" xml:id="trl-p1-l6"/>G-III K-#III-III ʿL
               <lb n="7" xml:id="trl-p1-l7"/>yzdṭdwhṭˈ YḤBWNṭˈ
               <lb n="8" xml:id="trl-p1-l8"/>ckˈ plhwdʾn ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0414_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Aspbād az ān ī
               <lb n="2" xml:id="trc-p1-l2"/>ō bun ēn Spandarmad
               <lb n="3" xml:id="trc-p1-l3"/>ī sāl 34 rōzīg ī
               <lb n="4" xml:id="trc-p1-l4"/>māh Wahman ud māh
               <lb n="5" xml:id="trc-p1-l5"/>Spandarmad rāy gandum
               <lb n="6" xml:id="trc-p1-l6"/>g(rīw) 3 k(abīz) 6 ō
               <lb n="7" xml:id="trc-p1-l7"/>Yazd-duxt dād
               <lb n="8" xml:id="trc-p1-l8"/>čak Farroxyān āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0414_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Aspbād from that which
               <lb n="2" xml:id="trans-p1-l2"/>(belongs) to the bun this (month) Spandarmad (12th month)
               <lb n="3" xml:id="trans-p1-l3"/>of year 34 as ration of
               <lb n="4" xml:id="trans-p1-l4"/>month Wahman (11th month) and of month
               <lb n="5" xml:id="trans-p1-l5"/>Spandarmad (12th month)
               <lb n="6" xml:id="trans-p1-l6"/>3 grīw (and) 6 kabīz of wheat to
               <lb n="7" xml:id="trans-p1-l7"/>Yazdduxt given.
               <lb n="8" xml:id="trans-p1-l8"/>Farroxyān sealed the čak.
            </ab>
         </div>
      </body>
   </text>
</TEI>