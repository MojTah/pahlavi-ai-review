   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0417_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>○○ plʾdy ẔNH BYRḤ hwrdṭ Y ŠNṬ
               <lb n="2" xml:id="trl-p1-l2"/>$$-III-III-III ḤS-III-II dykˈ Y interlinear: ○
               <lb n="3" xml:id="trl-p1-l3"/>......-III ... Y LWṬH
               <lb n="4" xml:id="trl-p1-l4"/>wʾhlʾm Y mṭrʾn YṬBWNṭˈ ckˈ
               <lb n="5" xml:id="trl-p1-l5"/>ʾwsṭʾndʾl ḤṬYMWNṭ ○○
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0417_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>○○ Frāy ēn māh Hordād ī sāl
               <lb n="2" xml:id="trc-p1-l2"/>49 may 5 dēg ī interlinear: ○
               <lb n="3" xml:id="trc-p1-l3"/>......-3 ... ī abāg
               <lb n="4" xml:id="trc-p1-l4"/>Wahrām ī Mihrān dād čak
               <lb n="5" xml:id="trc-p1-l5"/>ōstāndār āwišt ○○
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0417_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Frāy. Diesen Monat Hordād (3. Monat) des Jahres
               <lb n="2" xml:id="trans-p1-l2"/>49: Wein 5 (große) Kessel
               <lb n="3" xml:id="trans-p1-l3"/>...... 3. ... mit
               <lb n="4" xml:id="trans-p1-l4"/>Wahrām, Sohn des Mihr, gegeben. Den Scheck (hat)
               <lb n="5" xml:id="trans-p1-l5"/>der ōstāndār gesiegelt. 
            </ab>
         </div>
      </body>
   </text>
</TEI>