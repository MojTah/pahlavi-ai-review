   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85238-26.recto_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0026_trl-p1">
              <lb n="1" xml:id="trl-p1-l1"/>MKBLWNym dʾṭynˈ Y pṭˈ
              <lb n="2" xml:id="trl-p1-l2"/>nmyṭl dʾlyk SWSY ̓ Y
              <lb n="3" xml:id="trl-p1-l3"/>plhwṭl ʾwsṭʾndʾl lʾd ZNH BYRḤ
              <lb n="4" xml:id="trl-p1-l4"/>ddwˈ Y ŠNṬ 40–4-4 MN hlbwhṭˈ
              <lb n="5" xml:id="trl-p1-l5"/>Y pṭˈ šʾnṭˈ ˈ dʾlyk pṭˈ YDH
              <lb n="6" xml:id="trl-p1-l6"/>Y mʾhlwy ʾspsṭˈ 3–100
              <lb n="7" xml:id="trl-p1-l7"/>glṭkˈ pṭglʾb dʾṭynˈ pṭˈ gwkʾdymwdlyh ̓
              <lb n="8" xml:id="trl-p1-l8"/>Y mʾhpylwč ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0026_trc-p1">
              <lb n="1" xml:id="trc-p1-l1"/>padīrēm Dādēn ī pad
              <lb n="2" xml:id="trc-p1-l2"/>Namēwar dārīg asp ī
              <lb n="3" xml:id="trc-p1-l3"/>farroxtar ōstāndār rāy ēn māh
              <lb n="4" xml:id="trc-p1-l4"/>day ī sāl 48 az Xarbuxt
              <lb n="5" xml:id="trc-p1-l5"/>ī pad Šanat (?) dārīg pad dast
              <lb n="6" xml:id="trc-p1-l6"/>ī Māhrōy aspast 300
              <lb n="7" xml:id="trc-p1-l7"/>girdag padirāy Dādēn pad gugāy-muhrīhā
              <lb n="8" xml:id="trc-p1-l8"/>ī Māh-Pērōz āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="fr">
           <ab xml:id="MP0026_trans-p1">
              <lb n="1" xml:id="trans-p1-l1"/>Je reçois, (moi) Dādēn qui (est)
              <lb n="2" xml:id="trans-p1-l2"/>possédant à Namēwar, pour le cheval
              <lb n="3" xml:id="trans-p1-l3"/>du très honoré ōstāndār, ce mois de
              <lb n="4" xml:id="trans-p1-l4"/>Day de l’an 48, de la part de Xarbuxt,
              <lb n="5" xml:id="trans-p1-l5"/>qui (est) possédant à Šanat ( ?), par l’intermédiaire de
              <lb n="6" xml:id="trans-p1-l6"/>Māhrōy, trois cents bottes de luzerne,
              <lb n="7" xml:id="trans-p1-l7"/>le reçu a été scellé par les sceaux qui en témoignent
              <lb n="8" xml:id="trans-p1-l8"/>de Māh-Pērōz.
            </ab>
         </div>
      </body>
   </text>
</TEI>