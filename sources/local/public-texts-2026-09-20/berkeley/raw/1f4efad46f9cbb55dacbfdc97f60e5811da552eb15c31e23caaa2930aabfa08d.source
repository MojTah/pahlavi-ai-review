   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
             <pb xml:id="pb-1r-trl"/><!--facs="local:"-->
            <ab xml:id="MP2050_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ʿL lʾmšn' ʾlcʾnyk
               <lb n="2" xml:id="trl-p1-l2"/>krṭ' ʾnwšbht' dʾtlwy
               <lb n="3" xml:id="trl-p1-l3"/>Y MH plʾdwndʾṭʾn'
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP2050_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>ō rāmišn arzanīg
               <lb n="2" xml:id="trc-p1-l2"/>kard anōšbaxt Dādrōy
               <lb n="3" xml:id="trc-p1-l3"/>ī az Frāywindādān
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP2050_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>An den durch inneren Frieden würdig
               <lb n="2" xml:id="trans-p1-l2"/>gemachten, mit unsterblichem Glück versehenen Dādrōy,
               <lb n="3" xml:id="trans-p1-l3"/>Sohn des Frāwindād.
            </ab>
         </div>
      </body>
   </text>
</TEI>