   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0422_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ʾclmyk ʾḤṬH ʾšṭ-...(?) hmʾy ŠRM W KRʾ plhwyh
               <lb n="2" xml:id="trl-p1-l2"/>pṭˈ ...... ʾp̄ẕwnṭl YḤWWNʾt ◯ dlṭ-... Y ......
               <lb n="3" xml:id="trl-p1-l3"/>krṭˈ ʾš[ ]/// ...... lʾd lʾmšnˈ W dlṭ-...
               <lb n="4" xml:id="trl-p1-l4"/>krṭnˈ W ʾkʾsyh BʿYḤWNsṭn ...... ʿL ......
               <lb n="5" xml:id="trl-p1-l5"/>pṭˈ ...... s(ʾ)ht W MNW ṭnˈdrwsṭ drwysṭyh Y ......
               <lb n="6" xml:id="trl-p1-l6"/>...... ʿL L ʾy YKṬYBWNṭ W MN gwhl pṭˈ lʾmšnˈ ʾy
               <lb n="7" xml:id="trl-p1-l7"/>YḤWWNyt W pṭˈ ẔK Y syc ʾwhrmẕdʾndʾt
               <lb n="8" xml:id="trl-p1-l8"/>plydʾṭšnyk ʾy YḤWWNyṭ W ŠRM
               <lb n="9" xml:id="trl-p1-l9"/>ʾclmyk wʾt YḤWWNṭˈ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0422_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>āzarmīg xwah Āšt-...(?) hamē drōd ud harw farroxīh
               <lb n="2" xml:id="trc-p1-l2"/>pad ...... abzōntar bawād ◯ dard-... ī ......
               <lb n="3" xml:id="trc-p1-l3"/>kard ...[ ]/// ...... rāy rāmišn ud dard-...
               <lb n="4" xml:id="trc-p1-l4"/>kardan ud āgāhīh xwāstan ...... ō ......
               <lb n="5" xml:id="trc-p1-l5"/>pad ...... saxt ud kē tan-drust drustīh ī ......
               <lb n="6" xml:id="trc-p1-l6"/>...... ō man ē nibišt ud az gōhr pad rāmišn ē
               <lb n="7" xml:id="trc-p1-l7"/>bawēd ud pad ān ī sēǰ Ōhrmazdāndād
               <lb n="8" xml:id="trc-p1-l8"/>frayādišnīg ē bawēd ud drōd
               <lb n="9" xml:id="trc-p1-l9"/>āzarmīg wād būd
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0422_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Verehrte Schwester Āšt-...(?) immer Gesundheit und ganz Glückseligkeit
               <lb n="2" xml:id="trans-p1-l2"/>für ...... in (immer) größerem Maße sei!
               <lb n="3" xml:id="trans-p1-l3"/>gemacht (wurde?) [......] wegen......
               <lb n="4" xml:id="trans-p1-l4"/>...
               <lb n="5" xml:id="trans-p1-l5"/>für ...... ... und wer die vollständige Gesundheit von ......
               <lb n="6" xml:id="trans-p1-l6"/>...... mir geschrieben (Form?) und *von Herzen* beruhigt
               <lb n="7" xml:id="trans-p1-l7"/>seid und für jene Schwierigkeit(en) möge Ōhrmazdāndād
               <lb n="8" xml:id="trans-p1-l8"/>hilfreich sein. Und Gesundheit
               <lb n="9" xml:id="trans-p1-l9"/>verehrter *Geist sei(?).
            </ab>
         </div>
      </body>
   </text>
</TEI>