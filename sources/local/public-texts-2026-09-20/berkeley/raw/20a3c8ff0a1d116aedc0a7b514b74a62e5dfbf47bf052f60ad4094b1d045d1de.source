         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0427_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>nāzūg yazd
               <lb n="2" xml:id="trc-p1-l2"/>Frēdōn ō
               <lb n="3" xml:id="trc-p1-l3"/>Ōhrmazd ī bay kū-t
               <lb n="4" xml:id="trc-p1-l4"/>mih abdta
               <lb n="5" xml:id="trc-p1-l5"/>dīd kū
               <lb n="6" xml:id="trc-p1-l6"/>ēn-am abdtar
               <lb n="7" xml:id="trc-p1-l7"/>dīd kū kirm(?)
               <lb n="8" xml:id="trc-p1-l8"/>astag ē *āwāšēd
               <lb n="9" xml:id="trc-p1-l9"/>kū ēn ī tō dīd
               <lb n="10" xml:id="trc-p1-l10"/>nē abdtar kū ān ī man
               <lb n="11" xml:id="trc-p1-l11"/>dīd kū ēn-at dīd kū
               <lb n="12" xml:id="trc-p1-l12"/>ēn-am dīd ka-m ......
               <lb n="13" xml:id="trc-p1-l13"/>ō rōdag nišānēnd ud pad dandān
               <lb n="14" xml:id="trc-p1-l14"/>ud čā̂xš(?) nayēnd ud pad dandānnayēnd
               <lb n="15" xml:id="trc-p1-l15"/>ud(?) pad uzwān girdag bandēnd kū kē ēn ī tō
               <lb n="16" xml:id="trc-p1-l16"/>dīd ud ān ī tō dīd kū-t-iz pad karbās ī
               <lb n="17" xml:id="trc-p1-l17"/>kūk šalwār pad mēragīh man abdtar nišāst ud bandēd
               <lb n="18" xml:id="trc-p1-l18"/>ud *āwāšēd ud ka ēd kust wišād ...... ud ka
               <lb n="19" xml:id="trc-p1-l19"/>girdag wišād ō ēd
               <lb n="20" xml:id="trc-p1-l20"/>nāmag ˈ-satēr(?)-II kehtar andar
               <lb n="21" xml:id="trc-p1-l21"/>girdag ē band-[/////
               <lb n="22" xml:id="trc-p1-l22"/>]... kū
               <lb n="23" xml:id="trc-p1-l23"/>]ēn
               <lb n="24" xml:id="trc-p1-l24"/>]Frēdōn
               <lb n="25" xml:id="trc-p1-l25"/>...
               <lb n="26" xml:id="trc-p1-l26"/>...
               <lb n="27" xml:id="trc-p1-l27"/>...
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0427_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Lieblicher Geist 
               <lb n="1" xml:id="trans-p1-l2"/>Frēdōn an 
               <lb n="1" xml:id="trans-p1-l3"/>Ōhrmazd, den Herrn: du hast
               <lb n="1" xml:id="trans-p1-l4"/>etwas anderes (falsches, gegensätzliches) als wunderbarer
               <lb n="1" xml:id="trans-p1-l5"/>gesehen
               <lb n="1" xml:id="trans-p1-l6"/>als dieses, was ich so wunderbar
               <lb n="1" xml:id="trans-p1-l7"/>gesehen habe: daß die „Schlange“(?)
               <lb n="1" xml:id="trans-p1-l8"/>den Kern versiegeln194 soll:
               <lb n="1" xml:id="trans-p1-l9"/>dieses, was du gesehen hast,
               <lb n="1" xml:id="trans-p1-l10"/>(ist) nicht wunderbarer als jenes, was ich
               <lb n="1" xml:id="trans-p1-l11"/>gesehen habe: dieses hast du gesehen:
               <lb n="1" xml:id="trans-p1-l12"/>dieses habe ich gesehen: wenn sie mich ...
               <lb n="1" xml:id="trans-p1-l13"/>an ein Flüßchen(?) setzen und mit den Zähnen
               <lb n="1" xml:id="trans-p1-l14"/>und Geschmack(?)[= durch Kauen und Schmecken?] lassen sie (es?) bringen, und mit den Zähnen lassen sie (es) bringen
               <lb n="1" xml:id="trans-p1-l15"/>und(?) mit der Lasche (lit. Zunge) binden sie195 das Bündel: wer dieses von dir
               <lb n="1" xml:id="trans-p1-l16"/>gesehen hat und jenes von dir gesehen hat: auch dir aus kleinem Leinentuch
               <lb n="1" xml:id="trans-p1-l17"/>Hosen habe ich zur Jungehe(?) so wunderbar eingerichtet, und er bindet
               <lb n="1" xml:id="trans-p1-l18"/>und siegelt, und wenn diese Seite offen (sein sollte?) und wenn
               <lb n="1" xml:id="trans-p1-l19"/>das Bündel offen, diesem
               <lb n="1" xml:id="trans-p1-l20"/>Schreiben 2 Satēr weniger in das
               <lb n="1" xml:id="trans-p1-l21"/>Bündel soll(en) er (sie) bind[en ...
               <lb n="1" xml:id="trans-p1-l22"/>... daß
               <lb n="1" xml:id="trans-p1-l23"/>dies ...
               <lb n="1" xml:id="trans-p1-l24"/>Frēdōn
               <lb n="1" xml:id="trans-p1-l25-27"/>... ... ...
            </ab>
         </div>
      </body>
   </text>
