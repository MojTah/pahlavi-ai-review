               <lb n="2" xml:id="trl-p1-l2"/>plyṭwn ʿL
               <lb n="3" xml:id="trl-p1-l3"/>ʾwhrmẕd Y bg ʾYḴ-ṭ
               <lb n="4" xml:id="trl-p1-l4"/>mṭˈ ʾp̄dṭl
               <lb n="5" xml:id="trl-p1-l5"/>ḤẔYṬNt ʾYḴ
               <lb n="6" xml:id="trl-p1-l6"/>ẔNH-m ʾp̄dtl
               <lb n="7" xml:id="trl-p1-l7"/>ḤẔYṬNt ʾYḴ klm(?)
               <lb n="8" xml:id="trl-p1-l8"/>ʾsṭkˈ ʾy ḤṬYMWNyṭ
               <lb n="9" xml:id="trl-p1-l9"/>ʾYḴ ẔNH Y LK ḤẔYṬNṭ
               <lb n="10" xml:id="trl-p1-l10"/>Lʾ ʾp̄dṭl ʾYḴ ẔK Y L
               <lb n="11" xml:id="trl-p1-l11"/>ḤẔYṬNṭ ʾYḴ ẔNH-ṭ ḤẔYṬNṭ ʾYḴ
               <lb n="12" xml:id="trl-p1-l12"/>ẔNH-m ḤẔYṬNt ʾMṬ-m ......
               <lb n="13" xml:id="trl-p1-l13"/>ʿL lwṭkˈ YṬYBWNd W pṭˈ dndʾn
               <lb n="14" xml:id="trl-p1-l14"/>W c(ʾ)hš(?) YḎLWNd W pṭˈ dndʾn YḎLWNd
               <lb n="15" xml:id="trl-p1-l15"/>W(?) pṭˈ ʾwzwʾn glṭk ʾSLWNd ʾYḴ MNW ẔNH Y LK
               <lb n="16" xml:id="trl-p1-l16"/>ḤẔYṬNt W ẔK Y LK ḤẔYṬNt ʾYḴ-ṭ-c pṭˈ klbʾs Y
               <lb n="17" xml:id="trl-p1-l17"/>kwkˈ šlwʾl pṭˈ mylkyh L ʾp̄dṭl YṬYBWNṭ W ʾSLWNyt
               <lb n="18" xml:id="trl-p1-l18"/>W ḤṬYMWNyṭ W ʾMṬ ḤNʾ kwsṭˈ wšʾṭˈ ... ... W ʾMṬ
               <lb n="19" xml:id="trl-p1-l19"/>glṭkˈ wšʾṭˈ ʿL ḤNʾ
               <lb n="20" xml:id="trl-p1-l20"/>nʾmkˈ ˈ-S(?)-II ksṭl ḆYN
               <lb n="21" xml:id="trl-p1-l21"/>glṭkˈ ʾy ʾSLW/////
               <lb n="22" xml:id="trl-p1-l22"/>]... ʾYḴ
               <lb n="23" xml:id="trl-p1-l23"/>]ẔNH
               <lb n="24" xml:id="trl-p1-l24"/>]plyṭwn
               <lb n="25" xml:id="trl-p1-l25"/>]
               <lb n="26" xml:id="trl-p1-l26"/>]
               <lb n="27" xml:id="trl-p1-l27"/>]
            </ab>
