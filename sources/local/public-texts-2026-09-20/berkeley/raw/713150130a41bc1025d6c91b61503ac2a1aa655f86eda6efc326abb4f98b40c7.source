   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85260-43D.recto.2_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0047_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>bhṭybʾl Y PWN
               <lb n="2" xml:id="trl-p1-l2"/>dsṭkrṭ' Y (yṭk) Y
               <lb n="3" xml:id="trl-p1-l3"/>wndʾṭbwlcmṭrʾp̄ʾt
               <lb n="4" xml:id="trl-p1-l4"/>dʾlyk MN ẔK Y ʿL bwn'
               <lb n="5" xml:id="trl-p1-l5"/>ẔNH BYRḤ ʾ̄pʾn Y
               <lb n="6" xml:id="trl-p1-l6"/>ŠNT $$-IIII-IIII cygwn L
               <lb n="7" xml:id="trl-p1-l7"/>PWN hdybʾlyh plmwṭ'
               <lb n="8" xml:id="trl-p1-l8"/>YḤBWNṭn gwc' I-M dʾšn
               <lb n="9" xml:id="trl-p1-l9"/>W... ... $-III II... ...
               <lb n="10-11" xml:id="trl-p1-10-11"/><gap extent="line" reason="illegible"/>
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0047_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Baxtiyār ī pad
               <lb n="2" xml:id="trc-p1-l2"/>dastgird ī (ǰadag) ī
               <lb n="3" xml:id="trc-p1-l3"/>Windādburzmihr-ābād
               <lb n="4" xml:id="trc-p1-l4"/>dārīg az ān ī ō bun
               <lb n="5" xml:id="trc-p1-l5"/>ēn māh Ābān ī
               <lb n="6" xml:id="trc-p1-l6"/>sāl 48 čiyōn man
               <lb n="7" xml:id="trc-p1-l7"/>pad ayārīh framūd
               <lb n="8" xml:id="trc-p1-l8"/>dādan gōz 1000 dāšn
               <lb n="9" xml:id="trc-p1-l9"/>ud ... ... 26 ... ...
               <lb n="10-11" xml:id="trc-p1-10-11"/><gap extent="line" reason="illegible"/>
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0047_trans-p1">
               <lb n="1-4" xml:id="trans-p1-l1-4"/>Baxtiyār, manager on the estate of the property of Windādburzmihr-ābād, from that which [belongs] to the bun,
               <lb n="5" xml:id="trans-p1-l5"/>this month Ābān of the
               <lb n="6" xml:id="trans-p1-l6"/>year 48 I
               <lb n="7" xml:id="trans-p1-l7"/>for help ordered
               <lb n="8" xml:id="trans-p1-l8"/>to give, 1,000 nuts as gift
               <lb n="9" xml:id="trans-p1-l9"/>and .... ... 26 ... ...
               <lb n="10-11" xml:id="trans-p1-l10-11"/><gap extent="line" reason="illegible"/>
            </ab>
         </div>
      </body>
   </text>
