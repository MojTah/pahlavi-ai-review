   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0418_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>*ysnpʾnkˈ ......... Y NPŠH
               <lb n="2" xml:id="trl-p1-l2"/>{Y NPŠH} ʾclmykṭwm ʾḤṬH gwn-bh(ṭ)(?)
               <lb n="3" xml:id="trl-p1-l3"/>... ŠRM W ʾp̄lynˈ W KRʾ plhwyh
               <lb n="4" xml:id="trl-p1-l4"/>W lʾmšnˈ pṭˈ ẔK wṭyh ʾp̄ẕwnṭl W ʾyṭwnˈ
               <lb n="5" xml:id="trl-p1-l5"/>YḤWWNṭʾ cygwn dšnˈ L ẔK wṭyh lʾd
               <lb n="6" xml:id="trl-p1-l6"/>KRʾ wṭˈ Y wšʾṭ kʾmkˈ ○ L
               <lb n="7" xml:id="trl-p1-l7"/>cnd dwl ʾkʾsyh BʿYḤWNsṭnˈ Y MN
               <lb n="8" xml:id="trl-p1-l8"/>drwysṭyh Y LK .........
               <lb n="9" xml:id="trl-p1-l9"/>krṭˈ[   ]šʾnˈ(?) .........
               <lb n="10" xml:id="trl-p1-l10"/>ʾcbʾlkˈ lʾd dwšwʾlyh MN wṭyh
               <lb n="11" xml:id="trl-p1-l11"/>ẔK nkʾs YʾṬWNyṭ drwysṭyh Y
               <lb n="12" xml:id="trl-p1-l12"/>MN wṭyh W ḤṬ ...... ʿL L npšṭnˈ
               <lb n="13" xml:id="trl-p1-l13"/>plmwṭnˈ ʾy MDMHyṭ ʾy plmʾyṭ npšṭnˈ
               <lb n="14" xml:id="trl-p1-l14"/>W MN drwysṭyh Y L W hmplhwlṭ
            14bis   drwysṭ
               <lb n="15" xml:id="trl-p1-l15"/>plhwzʾṭˈ nyšʾn pṭˈ ʾšṭ
               <lb n="16" xml:id="trl-p1-l16"/>ḤṬʿLH pṭˈ lʾmšnˈ ʾy YḤWWNyṭ
               <lb n="17" xml:id="trl-p1-l17"/>............ YʾṬWNyṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0418_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>*yasn-bānag ......... ī xwēš
               <lb n="2" xml:id="trc-p1-l2"/>{ī xwēš} āzarmīgtom xwah Gōnbaxt(?)
               <lb n="3" xml:id="trc-p1-l3"/>... drōd ud āfrīn ud harw farroxīh
               <lb n="4" xml:id="trc-p1-l4"/>ud rāmišn pad ān wadīh abzōntar ud ēdōn
               <lb n="5" xml:id="trc-p1-l5"/>bawād čiyōn dašn man ān wadīh rāy
               <lb n="6" xml:id="trc-p1-l6"/>harw wad ī wišād kāmag ○ man
               <lb n="7" xml:id="trc-p1-l7"/>čand dūr āgāhīh xwāstan ī az
               <lb n="8" xml:id="trc-p1-l8"/>drustīh ī tō .........
               <lb n="9" xml:id="trc-p1-l9"/>kard[   ]šān(?) .........
               <lb n="10" xml:id="trc-p1-l10"/>Azbārag(?) rāy dušwārīh az wadīh
               <lb n="11" xml:id="trc-p1-l11"/>ān nigāh āyēd drustīh ī
               <lb n="12" xml:id="trc-p1-l12"/>az wadīh ud agar ...... ō man nibištan
               <lb n="13" xml:id="trc-p1-l13"/>framūdan ē sahēd ē framāyēd nibištan
               <lb n="14" xml:id="trc-p1-l14"/>ud az drustīh ī man ud ham-farroxtar
            14bis   drust
               <lb n="15" xml:id="trc-p1-l15"/>Farroxzād nīšān pad āšt
               <lb n="16" xml:id="trc-p1-l16"/>agar ōy pad rāmišn ē bawēd
               <lb n="17" xml:id="trc-p1-l17"/>............ āyēd
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0418_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>*Yasna-pflegend .........
               <lb n="2" xml:id="trans-p1-l2"/>verehrteste Schwester Gōnbaxt(?)
               <lb n="3" xml:id="trans-p1-l3"/>... Heil und Segen und ganze Glückseligkeit
               <lb n="4" xml:id="trans-p1-l4"/>und Frieden in ......... ebenso
               <lb n="5" xml:id="trans-p1-l5"/>soll er sein wie
               <lb n="6" xml:id="trans-p1-l6"/>(daß) alles Üble verschwinde, (das ist mein) Wunsch.
               <lb n="7" xml:id="trans-p1-l7"/>Wie sehr ich zu meiner Information (zu erfahren) wünsche in Bezug
               <lb n="8" xml:id="trans-p1-19"/>auf deine Gesundheit .........
               <lb n="9" xml:id="trans-p1-l9"/>gemacht .........
               <lb n="10" xml:id="trans-p1-l10"/>Azbārag(?) wegen Schwierigkeiten/Unglück von Üblem
               <lb n="11" xml:id="trans-p1-l11"/>aus Aufmerksamkeit kommt er/ihr Gesundheit die
               <lb n="12" xml:id="trans-p1-l12"/>von dem Übel und wenn es ...... mir schreiben
               <lb n="13" xml:id="trans-p1-l13"/>zu lassen gut erscheinen sollte, laßt schreiben
               <lb n="14" xml:id="trans-p1-l14"/>und wegen meiner Gesundheit und der des in gleicher Weise sehr glücklichen 
            [14bis] gesund
               <lb n="15" xml:id="trans-p1-l15"/>Farroxzād ein Zeichen im Frieden.
               <lb n="16" xml:id="trans-p1-l16"/>Wenn ihnen Muße sein sollte,
               <lb n="17" xml:id="trans-p1-l17"/>......... kommt (er/ihr).
            </ab>
         </div>
      </body>
   </text>
</TEI>