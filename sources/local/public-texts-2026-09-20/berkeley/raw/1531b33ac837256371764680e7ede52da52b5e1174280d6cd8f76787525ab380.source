   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85227-13.recto_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0013_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>dʾṭynˈ gwpṭˈ ʾYK 
               <lb n="2" xml:id="trl-p1-l2"/>L NKSY ̓ S-2 Y 
               <lb n="3" xml:id="trl-p1-l3"/>QDM n ̓mkˈ MNW ZNH ʾbydʾṭkʾl 
               <lb n="4" xml:id="trl-p1-l4"/>ʾwbš wylʾsṭ W npšṭˈ 
               <lb n="5" xml:id="trl-p1-l5"/>YKʿYMWNyṭ MN mʾhpylwčˈ 
               <lb n="6" xml:id="trl-p1-l6"/>MKBLWNym W bnd Y 
               <lb n="7" xml:id="trl-p1-l7"/>ZNH ʾbydʾṭ[k]ʾl 
               <lb n="8" xml:id="trl-p1-l8"/>(dʾṭynˈ) suivi de lʾd (?) 
               <lb n="9" xml:id="trl-p1-l9"/>pṭˈ gwkʾdymwdlyhʾ Y 
               <lb n="10" xml:id="trl-p1-l10"/>ʾrṭhšṭl Y plhwhwslw ̓n 
               <lb n="11" xml:id="trl-p1-l11"/>ḤṬYMWNṭ </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0013_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Dādēn guft kū 
               <lb n="2" xml:id="trc-p1-l2"/>man xwāstag satēr 2 ī 
               <lb n="3" xml:id="trc-p1-l3"/>abar nāmag kē ēn ayādgār 
               <lb n="4" xml:id="trc-p1-l4"/>awiš wirāst ud nibišt 
               <lb n="5" xml:id="trc-p1-l5"/>ēstēd az Māh-Pērōz 
               <lb n="6" xml:id="trc-p1-l6"/>padīrēm ud band ī 
               <lb n="7" xml:id="trc-p1-l7"/>ēn ayādgār 
               <lb n="8" xml:id="trc-p1-l8"/>Dādēn (?) &lt;rāy&gt;
               <lb n="9" xml:id="trc-p1-l9"/>pad gugāy-muhrīhā ī 
               <lb n="10" xml:id="trc-p1-l10"/>Ardaxšīr ī Farrox-Husravān 
               <lb n="11" xml:id="trc-p1-l11"/>āwišt </ab>
         </div>
         <div type="translation" xml:lang="fr">
            <ab xml:id="MP0013_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dādēn a dit: 
               <lb n="2" xml:id="trans-p1-l2"/>Moi, l’argent de 2 satēr [= 8 drachmes] 
               <lb n="3" xml:id="trans-p1-l3"/>sur la lettre dans laquelle ce mémorandum 
               <lb n="4" xml:id="trans-p1-l4"/>a été préparé et écrit 
               <lb n="5" xml:id="trans-p1-l5"/>par Māh-Pērōz, 
               <lb n="6" xml:id="trans-p1-l6"/>je (les) reçois, et l’attache de 
               <lb n="7" xml:id="trans-p1-l7"/>ce mémorandum, 
               <lb n="8" xml:id="trans-p1-l8"/>Dādēn ...l’a scellé 
               <lb n="9" xml:id="trans-p1-l9"/>avec les sceaux qui en témoignent de 
               <lb n="10" xml:id="trans-p1-l10"/>Ardaxšīr fils de Farrox-Husravān.
            </ab>
         </div>
      </body>
   </text>
</TEI>