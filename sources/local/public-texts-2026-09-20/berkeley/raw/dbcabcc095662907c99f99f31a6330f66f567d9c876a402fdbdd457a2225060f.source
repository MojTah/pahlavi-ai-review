    <text>
        <body>
            <div type="transliteration" xml:lang="pal">
                <pb xml:id="pb-1r-trl"/> <!-- Add later facs="brooklyn:UNKNOWN" -->
                <ab xml:id="MP2051_trl-p1">
                    <lb n="1" xml:id="trl-p1-l1"/><damage extent="1 line"/><unclear reason="damage"/><damage extent="unclear"/>
                    <lb n="2" xml:id="trl-p1-l2"/>ŠḆKWNty dʾštnˈ MH<damage type="tear"/>
                    <lb n="3" xml:id="trl-p1-l3"/><damage/><unclear reason="illegible" extent="1 word"/> MN CBW YMLLWNṭnˈ Y<damage extent="unclear"/>
                    <lb n="4" xml:id="trl-p1-l4"/>ʿL L ʾkʾsyh ʾy YḤWWNyt <pc function="section">○</pc> <damage extent="unclear"/><note place="below">MRʿḤ</note>
                    <lb n="5" xml:id="trl-p1-l5"/>dwšʾlmyh <unclear reason="illegible" extent="2 words"/>tny<damage extent="unclear"/>
                    <lb n="6" xml:id="trl-p1-l6"/>Y MRʿḤ scšnyk <damage extent="unclear"/>
                    <lb n="7" xml:id="trl-p1-l7"/>Y ʾMT L(Ṭ)MH YMṬ <unclear reason="illegible" extent="1 word">m</unclear> <damage extent="unclear"/>
                    <lb n="8" xml:id="trl-p1-l8"/><unclear reason="illegible"/>WNʾtˈ mtˈ ẔK <damage extent="unclear"/>
                    <lb n="9" xml:id="trl-p1-l9"/><unclear reason="faded"/>ytˈ pṭˈ cnd <damage extent="unclear"/>
                    <lb n="10" xml:id="trl-p1-l10"/>ʿL L ʾkʾ<unclear>syh</unclear> ʾy YḤWWN.<damage extent="unclear"/>
                    <lb n="11" xml:id="trl-p1-l11"/>ʿL L <unclear reason="illegible">m</unclear><damage extent="1 word" type="torn"/> YḤWWNm <damage extent="unclear"/>
                    <lb n="12" xml:id="trl-p1-l12"/>ʾsym <unclear reason="illegible" extent="several words"/><damage extent="unclear"/>
                    <lb n="13" xml:id="trl-p1-l13"/><damage extent="1 line"/>
                </ab>
            </div>
            <div type="transcription" xml:lang="pal">
                <ab xml:id="MP2051_trc-p1">
                    <lb n="1" xml:id="trc-p1-l1"/><damage extent="1 line"/><unclear reason="damage"/><damage extent="end of line"/>
                    <lb n="2" xml:id="trc-p1-l2"/>hilēd dāštan čē<damage type="tear"/>
                    <lb n="3" xml:id="trc-p1-l3"/><damage/><unclear reason="illegible" extent="1 word"/> az xīr guftan ī<damage extent="end of line"/>
                    <lb n="4" xml:id="trc-p1-l4"/>ō man āgāhīh ē bawēd <pc function="section">○</pc> <damage extent="unclear"/><note place="below">xwadāy</note>
                    <lb n="5" xml:id="trc-p1-l5"/>dōšāramih <unclear reason="illegible" extent="2 words"/><damage extent="unclear"/>
                    <lb n="6" xml:id="trc-p1-l6"/>ī xwadāy sazišnīg <damage extent="unclear"/>
                    <lb n="7" xml:id="trc-p1-l7"/>ī ka ēdar <unclear reason="illegible" extent="1 word">ēm</unclear><damage extent="unclear"/>
                    <lb n="8" xml:id="trc-p1-l8"/><unclear reason="illegible"/>ād mih ān <damage extent="unclear"/>
                    <lb n="9" xml:id="trc-p1-l9"/><unclear reason="faded"/>ēd pad čand <damage extent="unclear"/>
                    <lb n="10" xml:id="trc-p1-l10"/>ō man āgā<unclear>hīh</unclear> ē baw<damage extent="unclear"/>
                    <lb n="11" xml:id="trc-p1-l11"/>ō man <unclear reason="illegible">m</unclear><damage extent="1 word" type="torn"/> bawēm <damage extent="unclear"/>
                    <lb n="12" xml:id="trc-p1-l12"/>asēm <unclear reason="illegible" extent="several words"/><damage extent="unclear"/>
                    <lb n="13" xml:id="trc-p1-l13"/><damage extent="1 line"/>
                </ab>
            </div>
            <div type="translation" xml:lang="de">
                <ab xml:id="MP2051_trans-p1">
                    <lb n="1" xml:id="trans-p1-l1"/><damage extent="1 line"/><unclear reason="damage"/><damage extent="end of line"/>
                    <lb n="2" xml:id="trans-p1-l2"/>man läßt zu behalten was<damage extent="unclear"/>
                    <lb n="3" xml:id="trans-p1-l3"/><damage/><unclear reason="illegible" extent="1 word"/>von der Sache zu sprechen <damage extent="unclear"/>
                    <lb n="4" xml:id="trans-p1-l4"/>mir soll zur Kenntnis werden <pc function="section">○</pc> <note place="below">Herr</note>
                    <lb n="5" xml:id="trans-p1-l5"/>Liebe <unclear reason="illegible" extent="2 words"/><damage extent="unclear"/>
                    <lb n="6" xml:id="trans-p1-l6"/>des Herrn geziemend? <damage extent="unclear"/>
                    <lb n="7" xml:id="trans-p1-l7"/> ... wenn ich hier <unclear reason="illegible" extent="1 word"/><damage extent="unclear"/>
                    <lb n="8" xml:id="trans-p1-l8"/><unclear reason="illegible"/> falsch jenes <damage extent="unclear"/>
                    <lb n="9" xml:id="trans-p1-l9"/><unclear reason="faded"/> für so viel(e) <damage extent="unclear"/>
                    <lb n="10" xml:id="trans-p1-l10"/>mir soll zur Kenntnis werden <damage extent="unclear"/>
                    <lb n="11" xml:id="trans-p1-l11"/>mir <unclear reason="illegible"/> soll ich werden <damage extent="unclear"/>
                    <lb n="12" xml:id="trans-p1-l12"/>Silber <unclear reason="illegible" extent="several words"/><damage extent="unclear"/>
                    <lb n="13" xml:id="trans-p1-l13"/><damage extent="1 line"/>
                </ab>
            </div>
        </body>
    </text>
