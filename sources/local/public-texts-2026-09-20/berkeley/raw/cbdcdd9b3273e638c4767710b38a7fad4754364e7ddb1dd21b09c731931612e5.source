   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0420_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ẔK ywbʾl YḆLWNty pṭˈ MṬʾ
               <lb n="2" xml:id="trl-p1-l2"/>krṭnˈ lʾd plmwṭˈ npšṭnˈ
               <lb n="3" xml:id="trl-p1-l3"/> L LṬMH MNW-m-c ʾdwynkˈ
               <lb n="4" xml:id="trl-p1-l4"/>pṭˈ msʾn(?) krṭnˈ lʾd ṭwrk(?)
               <lb n="5" xml:id="trl-p1-l5"/>W pylwcˈ Y LWṬH mʾhʾṭ-wlk[(?)
               <lb n="6" xml:id="trl-p1-l6"/>Y lsyk ʿL lwcwhwṭʾk(?)
               <lb n="7" xml:id="trl-p1-l7"/>ksy(?) krṭˈ
               <lb n="8" xml:id="trl-p1-l8"/>.........
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0420_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>ān ǰuwāl barēd pad deh
               <lb n="2" xml:id="trc-p1-l2"/>kardan rāy framūd nibištan
               <lb n="3" xml:id="trc-p1-l3"/>man ēdar kē-m-iz ēwēnag
               <lb n="4" xml:id="trc-p1-l4"/>pad mehān(?) kardan rāy Tūrag(?)
               <lb n="5" xml:id="trc-p1-l5"/>ud Pērōz ī abāg Māhād-Warrag[
               <lb n="6" xml:id="trc-p1-l6"/>ī rahīg ō Rōzwehtāg(?)
               <lb n="7" xml:id="trc-p1-l7"/>keh(?) kard
               <lb n="8" xml:id="trc-p1-l8"/>.........
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0420_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Jenen Sack soll er bringen, um für das Dorf
               <lb n="2" xml:id="trans-p1-l2"/>(etwas) zu tun befohlen zu schreiben
               <lb n="3" xml:id="trans-p1-l3"/>mir hier, wie auch ich
               <lb n="4" xml:id="trans-p1-l4"/>(etwas) für die Älteren(?) zu machen Tūrag(?)
               <lb n="5" xml:id="trans-p1-l5"/>und Pērōz der mit Māhād-Warrag(?)
               <lb n="6" xml:id="trans-p1-l6"/>dem Jungen dem ... ...
               <lb n="7" xml:id="trans-p1-l7"/>geringer(?) gemacht.
               <lb n="8" xml:id="trans-p1-l8"/>.........
            </ab>
         </div>
      </body>
   </text>
