   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!-- Add later facs="LA:UNKNOWN" -->
            <ab xml:id="MP0454_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/><persName ref="people:CIr009">dʾṭyn-wndʾṭˈ</persName> YWM
               <lb n="2" xml:id="trl-p1-l2"/>whwmnˈ ŠG K-#III
               <lb n="3" xml:id="trl-p1-l3"/>W ʾssṭˈ IIII glṭk
               <lb n="4" xml:id="trl-p1-l4"/>W ṬBNʾ-II dwl ʿL
               <lb n="5" xml:id="trl-p1-l5"/>ʾdwkˈ Y ...-ʾn
               <lb n="6" xml:id="trl-p1-l6"/>YḤBWNṭˈ ...-ʾnˈ
               <lb n="7" xml:id="trl-p1-l7"/>npšṭ(ˈ)
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0454_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/><persName ref="people:CIr009">Dādēn-Windād</persName> rōz
               <lb n="1" xml:id="trc-p1-l2"/>Wahman ǰaw kabīz 3
               <lb n="1" xml:id="trc-p1-l3"/>ud aspast 4 girdag
               <lb n="1" xml:id="trc-p1-l4"/>ud kāh-2 dōl ō
               <lb n="1" xml:id="trc-p1-l5"/>Ewag(?) ī ...-ān
               <lb n="1" xml:id="trc-p1-l6"/>dād N.N.
               <lb n="1" xml:id="trc-p1-l7"/>nibišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0454_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dādēn-Windād(?): Tag
               <lb n="1" xml:id="trans-p1-l2"/>Wahman (2 Tag) ... und Gerste 3 kabīz
               <lb n="1" xml:id="trans-p1-l3"/>und Luzerne 4 Ballen
               <lb n="1" xml:id="trans-p1-l4"/>und Stroh 2 dōl dem
               <lb n="1" xml:id="trans-p1-l5"/>Ewag(?), (Sohn des) ...
               <lb n="1" xml:id="trans-p1-l6"/>zu geben. N.N. (hat’s)
               <lb n="1" xml:id="trans-p1-l7"/>geschrieben.
            </ab>
         </div>
      </body>
   </text>
