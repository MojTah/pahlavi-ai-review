   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!-- Add later facs="LA:UNKNOWN" -->
            <ab xml:id="MP0452_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>[ʿ]L (yẕdʾn) plhwṭl krṭˈ
               <lb n="2" xml:id="trl-p1-l2"/>W ʾclmykṭwm ʾḤ *<persName ref="people:CIr016">ysnpʾṭʾl</persName>
               <lb n="3" xml:id="trl-p1-l3"/>hmʾy MNW lʾmšnˈ W KRʾ plhwyh
               <lb n="4" xml:id="trl-p1-l4"/>pṭˈ ʾḤY ʾzwnṭl W ʾyṭwnˈ
               <lb n="5" xml:id="trl-p1-l5"/>YḤWWNʾṭ cygwn dšnˈ MRʿḤ ʿL
               <lb n="6" xml:id="trl-p1-l6"/>ʾḤ(Y) Y LK cnd wšʾtˈ kʾmkˈ
               <lb n="7" xml:id="trl-p1-l7"/>◯ . . . . . -yh Y MRʿḤ ʿL L krṭˈ
               <lb n="8" xml:id="trl-p1-l8"/>ʾšṭwyh(?) MN drwysṭyh Y MRʿḤ
               <lb n="9" xml:id="trl-p1-l9"/>lʾd *<persName ref="people:CIr016">ysnpʾṭʾl</persName> lʾm...(?) MRʿḤ
               <lb n="10" xml:id="trl-p1-l10"/>MN drwysṭyh Y L pṭˈ
               <lb n="11" xml:id="trl-p1-l11"/>lʾm(šnˈ) (ʾy) YḤWWNyṭ (ŠRM)
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0452_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>(ō) yazadān farroxtar kard
               <lb n="2" xml:id="trc-p1-l2"/>ud āzarmīgtom brād *<persName ref="people:CIr016">Yasn-pādār</persName>
               <lb n="3" xml:id="trc-p1-l3"/>...... rāmišn ud harw farroxīh
               <lb n="4" xml:id="trc-p1-l4"/>pad brād abzōntar ud ēdōn
               <lb n="5" xml:id="trc-p1-l5"/>bawād čiyōn dašn xwadāy ō
               <lb n="6" xml:id="trc-p1-l6"/>brād ī tō čand wišād kāmag
               <lb n="7" xml:id="trc-p1-l7"/>...... ī xwadāy ō man kard
               <lb n="8" xml:id="trc-p1-l8"/>Āšt-...(?) az drustīh ī xwadāy
               <lb n="9" xml:id="trc-p1-l9"/>rāy *<persName ref="people:CIr016">Yasn-pādār</persName> ...... xwadāy
               <lb n="10" xml:id="trc-p1-l10"/>az drustīh ī man pad
               <lb n="11" xml:id="trc-p1-l11"/>rāmišn ē(?) bawēd (drōd)
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0452_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Dem durch die Götter glückseliger gemachten
               <lb n="2" xml:id="trans-p1-l2"/>und verehrtesten Bruder *Yasn-pādār
               <lb n="3" xml:id="trans-p1-l3"/>... Verehrung(?), in Frieden und ganzer Glückseligkeit
               <lb n="4" xml:id="trans-p1-l4"/>für den Bruder (immer) mehr und ebenso
               <lb n="5" xml:id="trans-p1-l5"/>soll es sein, wie sehr sie, Herr, dem
               <lb n="6" xml:id="trans-p1-l6"/>Bruder von dir (gegenüber) den Wunsch, daß die Schwäche verschwindet, hegen.
               <lb n="7" xml:id="trans-p1-l7"/>......des Herrn mir gemacht
               <lb n="8" xml:id="trans-p1-l8"/>Āšt-...(?) wegen der Gesundheit des Herrn
               <lb n="9" xml:id="trans-p1-l9"/>und der *Yasn-pādār ... Herr
               <lb n="10" xml:id="trans-p1-10"/>Bezüglich meiner Gesundheit in
               <lb n="11" xml:id="trans-p1-l11"/>Ruhe möget sein, (Gesundheit)
            </ab>
         </div>
      </body>
   </text>
</TEI>