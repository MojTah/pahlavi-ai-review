   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0421_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>plhwˈ hwṭʾykˈ dʾṭgwšnsp pṭˈ hmʾy
               <lb n="2" xml:id="trl-p1-l2"/>plhwṭl W pṭˈ KRʾ ʾp̄ẕʾdšnˈ
               <lb n="3" xml:id="trl-p1-l3"/>kʾmk ...... L YḤWWNʾt ◯ dlṭ-...
               <lb n="4" xml:id="trl-p1-l4"/>Y hwṭʾykˈ ʿL L krṭˈ ʾšṭwyh(?)
               <lb n="5" xml:id="trl-p1-l5"/>W plhwˈ drwysṭyh Y hwṭʾykˈ lʾd
               <lb n="6" xml:id="trl-p1-l6"/>MN ..................... lʾmšnˈ
               <lb n="7" xml:id="trl-p1-l7"/>◯ ...........................
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0421_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>farrox xwadāyīg Dād-Gušnasp pad hamē
               <lb n="2" xml:id="trc-p1-l2"/>farroxtar ud pad harw abzāyišn
               <lb n="3" xml:id="trc-p1-l3"/>kāmag ...... man bawād ◯ dard-...(?)
               <lb n="4" xml:id="trc-p1-l4"/>ī xwadāyīg ō man kard Āštweh(?)
               <lb n="5" xml:id="trc-p1-l5"/>ud farrox drustīh ī xwadāyīg rāy
               <lb n="6" xml:id="trc-p1-l6"/>az ..................... rāmišn
               <lb n="7" xml:id="trc-p1-l7"/>◯ ...........................
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0421_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Der glückliche (und) herrschaftliche Dād-Gušnasp
               <lb n="2" xml:id="trans-p1-l2"/>glückseliger und in ganzem Gedeihen
               <lb n="3" xml:id="trans-p1-l3"/>Wunsch ...... sei mir. ...
               <lb n="4" xml:id="trans-p1-l4"/>des Herrn mir gemacht. Āšt-...(?)
               <lb n="5" xml:id="trans-p1-l5"/>und ...... Gesundheit
               <lb n="6" xml:id="trans-p1-l6"/>von ...........................
               <lb n="7" xml:id="trans-p1-l7"/>...........................
            </ab>
         </div>
      </body>
   </text>
