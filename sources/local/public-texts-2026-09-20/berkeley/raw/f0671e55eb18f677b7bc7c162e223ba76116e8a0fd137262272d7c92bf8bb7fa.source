      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0431_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>nʾmkˈ
               <lb n="2" xml:id="trl-p1-l2"/>[ʿ](L) LK(WM ...)
               <lb n="3-6" xml:id="trl-p1-l3-6"/>erodiert
               <lb n="7" xml:id="trl-p1-l7"/>ẔY nʾm(?)
               <lb n="8" xml:id="trl-p1-l8"/>ẔNH nʾmkˈ
               <lb n="9" xml:id="trl-p1-l9"/>ḤNʾ lʾd
               <lb n="10" xml:id="trl-p1-l10"/>krṭˈ MH
               <lb n="11" xml:id="trl-p1-l11"/>lʾd hwnsnd
               <lb n="12" xml:id="trl-p1-l12"/>ḤṬYMWNṭ
               <lb n="13" xml:id="trl-p1-l13"/>vermutlich frei
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0431_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>nāmag
               <lb n="2" xml:id="trc-p1-l2"/>(ō šmāh ...)
               <lb n="3-6" xml:id="trc-p1-l3-6"/>erodiert
               <lb n="7" xml:id="trc-p1-l7"/>ī nām(?)
               <lb n="8" xml:id="trc-p1-l8"/>ēn nāmag
               <lb n="9" xml:id="trc-p1-l9"/>ēd rāy
               <lb n="10" xml:id="trc-p1-l10"/>kard čē
               <lb n="11" xml:id="trc-p1-l11"/>rāy hunsand
               <lb n="12" xml:id="trc-p1-l12"/>āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0431_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Der Brief
               <lb n="2" xml:id="trans-p1-l2"/>(an Euch?)
               <lb n="3-6" xml:id="trans-p1-l3-6"/>erodiert
               <lb n="7" xml:id="trans-p1-l7"/>...
               <lb n="8" xml:id="trans-p1-l8"/>dieser Brief
               <lb n="9" xml:id="trans-p1-l9"/>deswegen
               <lb n="10-11" xml:id="trans-p1-l10-11"/>geschrieben (lit. gemacht), weswegen zufrieden
               <lb n="11" xml:id="trans-p1-l12"/>gesiegelt.
            </ab>
         </div>
