   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/>
            <ab xml:id="MP5651_trl-p1">
               <lb n="1" xml:id="trl-p1-l2"/>l(yš)pʾtk'
               <lb n="2" xml:id="trl-p1-l3"/>ZK kʾl(y)kl
               <lb n="3" xml:id="trl-p1-l4"/>mtr' p(ʾt)ʾrk'
               <lb n="4" xml:id="trl-p1-l5"/>MḤYTWNt'
               <lb n="5" xml:id="trl-p1-l6"/>W ZWZN XXX YḤBW(N)ty'
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP5651_trc-p1">
               <lb n="1" xml:id="trc-p1-l2"/>Rēšbādag
               <lb n="2" xml:id="trc-p1-l3"/>ān kāregar (ī)
               <lb n="3" xml:id="trc-p1-l4"/>Mihrbādārag
               <lb n="4" xml:id="trc-p1-l5"/>zād
               <lb n="5" xml:id="trc-p1-l6"/>ud drahm 30 dād
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP5651_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Rēšbādag
               <lb n="2" xml:id="trans-p1-l2"/>that worker of
               <lb n="3" xml:id="trans-p1-l3"/>Mihrbādārag
               <lb n="4" xml:id="trans-p1-l4"/>struck
               <lb n="5" xml:id="trans-p1-l5"/>and gave 30 drahm
            </ab>
         </div>
      </body>
   </text>
