   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="local:P_55_R.jpg"-->
            <ab xml:id="MP2300_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>○○ gwnd Y šylk' MN ʾlpnṭydnyʾ 24
               <lb n="2" xml:id="trl-p1-l2"/>○ MN hlklyʾ 21 ○ MN kwsylynkws
               <lb n="3" xml:id="trl-p1-l3"/>24 ○ MN kynwn 7 ○ MN ṭyʾdwsypwlys
               <lb n="4" xml:id="trl-p1-l4"/>10 ○ MN hlmwpwlys 62 ○ MN
               <lb n="5" xml:id="trl-p1-l5"/>ʾnṭynwk' 6 ○ MN kwswn' 6
               <lb n="6" xml:id="trl-p1-l6"/>○ MN lykws 20 ○ MN dyʾspwlys
               <lb n="7" xml:id="trl-p1-l7"/>2 ○ MN mks(mn)wpwlys 1
               <lb n="8" xml:id="trl-p1-l8"/>[... ? ...]
            </ab>
         </div>
<!--          <div type="transcription" xml:lang="pal">
            <ab xml:id="MP2300_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>transcription not published
            </ab>
         </div> -->
         <div type="translation" xml:lang="en">
            <ab xml:id="MP2300_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>The group of Šērag: from Elephantine 24 (men)
               <lb n="2" xml:id="trans-p1-l2"/>from Herakleia 21 (men), from Oxyrhynchus
               <lb n="3" xml:id="trans-p1-l3"/>24 (men), from Kynōn 7 (men), from Theodosiopolis
               <lb n="4" xml:id="trans-p1-l4"/>10 (men), from Hermopolis 62 (men), from
               <lb n="5" xml:id="trans-p1-l5"/>Antinoe 6 (men), from Kossōn (men),
               <lb n="6" xml:id="trans-p1-l6"/>from Lykos (Lykopolis) 20 (men), from Diospolis
               <lb n="7" xml:id="trans-p1-l7"/>2 (men) from Maxi(mian)opolis 1 (men).
               <lb n="8" xml:id="trans-p1-l8"/>... ...
            </ab>
         </div>
      </body>
   </text>
</TEI>