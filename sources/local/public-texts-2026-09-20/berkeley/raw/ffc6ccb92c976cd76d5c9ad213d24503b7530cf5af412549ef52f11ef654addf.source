   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!-- add facs="" once an image is available -->
            <ab xml:id="MP0603_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>bʾpkˈ Y ʾsyʾkbʾn
               <lb n="2" xml:id="trl-p1-l2"/>ẔNH BYRḤ whwmnˈ Y
               <lb n="3" xml:id="trl-p1-l3"/>ŠNT XXX-IIII-IIII Y
               <lb n="4" xml:id="trl-p1-l4"/>mzd Y ẔNH …tnˈ Y
               <lb n="5" xml:id="trl-p1-l5"/>grmkˈ G-III Y lwcyk
               <lb n="6" xml:id="trl-p1-l6"/>Y ʾḤTH Y plhwzʾtˈ
               <lb n="7" xml:id="trl-p1-l7"/>lʾd ḤG K-II lʾd
               <lb n="8" xml:id="trl-p1-l8"/>BʿYḤWNstˈ W MN
               <lb n="9" xml:id="trl-p1-l9"/><unclear reason="illegible" extent="several words"/> ẔK
               <lb n="10" xml:id="trl-p1-l10"/><unclear reason="illegible" extent="several words"/> ml
               <lb n="11" xml:id="trl-p1-l11"/>hngʾltnˈ lʾd
               <lb n="12" xml:id="trl-p1-l12"/>zʾtʾnplhwˈ
               <lb n="13" xml:id="trl-p1-l13"/>ḤTYMWNt
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0603_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Bābag ī āsyāgbān
               <lb n="2" xml:id="trc-p1-l2"/>ēn māh Wahman ī
               <lb n="3" xml:id="trc-p1-l3"/>sāl 38 ī
               <lb n="4" xml:id="trc-p1-l4"/>mizd ī ēn …tan ī
               <lb n="5" xml:id="trc-p1-l5"/>garmak grīw 3 ī rōzīg
               <lb n="6" xml:id="trc-p1-l6"/>ī xwah ī Farroxzād
               <lb n="7" xml:id="trc-p1-l7"/>rāy gandum kabīz 2 rāy
               <lb n="8" xml:id="trc-p1-l8"/>xwāst ud az
               <lb n="9" xml:id="trc-p1-l9"/><unclear reason="illegible" extent="several words"/> ān
               <lb n="10" xml:id="trc-p1-l10"/><unclear reason="illegible" extent="several words"/> mar
               <lb n="11" xml:id="trc-p1-l11"/>hangārdan rāy
               <lb n="12" xml:id="trc-p1-l12"/>Zādānfarrox
               <lb n="13" xml:id="trc-p1-l13"/>āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0603_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Bābag the miller (āsyāgbān)
               <lb n="2" xml:id="trans-p1-l2"/>This month Wahman (11th month) of
               <lb n="3" xml:id="trans-p1-l3"/>year 38
               <lb n="4" xml:id="trans-p1-l4"/>For the reward of… of
               <lb n="5" xml:id="trans-p1-l5"/>3 grīw of garmak (which is) the ration of
               <lb n="6" xml:id="trans-p1-l6"/>Farroxzād’s sister
               <lb n="7" xml:id="trans-p1-l7"/>2 kabīz of wheat
               <lb n="8" xml:id="trans-p1-l8"/>wanted and from
               <lb n="9" xml:id="trans-p1-l9"/><unclear reason="illegible" extent="several words"/>that
               <lb n="10-11" xml:id="trans-p1-l10-11"/><unclear reason="illegible" extent="several words"/> to reckon
               <lb n="12" xml:id="trans-p1-l12"/>Zādānfarrox
               <lb n="13" xml:id="trans-p1-l13"/>sealed.
            </ab>
         </div>
      </body>
   </text>
</TEI>