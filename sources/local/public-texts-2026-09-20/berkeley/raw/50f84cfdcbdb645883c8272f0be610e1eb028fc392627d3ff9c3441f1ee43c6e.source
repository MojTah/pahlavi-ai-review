   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0437_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>◯ (d)hmksṭʾnˈ nzdsṭˈ S-$-X-III-III-III dṭykl
               <lb n="2" xml:id="trl-p1-l2"/>S-$-$-X-III-III sṭykl S-$-X
               <lb n="3" xml:id="trl-p1-l3"/>I ẔWẔN I KḤDH S-I-C $-III-III ẔWẔN I ◯
               <lb n="4" xml:id="trl-p1-l4"/>ṭʾckrṭˈ nzdsṭˈ S-IIII-IIII ẔWẔN II
               <lb n="5" xml:id="trl-p1-l5"/>dṭykl S-$-III-II sṭykl S-X
               <lb n="6" xml:id="trl-p1-l6"/>KḤDH S-$$-III ẔWẔN II ◯ glʾmkˈ nzdstˈ 
   superscriptum: [ẔWẔN II]
               <lb n="7" xml:id="trl-p1-l7"/>S-III ẔWẔN III dṭykl S-IIII-IIII sṭykl
               <lb n="8" xml:id="trl-p1-l8"/>S-III KḤDH S-X-III-II ẔWẔN I ◯ mṭrʾp̄ʾṭˈ
               <lb n="9" xml:id="trl-p1-l9"/>sṭykl S-III ẔWẔN III ◯ lšnwkˈ
               <lb n="10" xml:id="trl-p1-l10"/>nzdstˈ S-$$-IIII-III ẔWẔN II dṭykl[
               <lb n="11" xml:id="trl-p1-l11"/>]...[
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0437_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>◯ A (D)axmagestān nazdist satēr-39 dudīgar
               <lb n="2" xml:id="trc-p1-l2"/>satēr-56 sidīgar satēr-30
               <lb n="3" xml:id="trc-p1-l3"/>1 drahm 1 hā̆mist satēr-126 drahm 1 ◯
               <lb n="4" xml:id="trc-p1-l4"/>B Tāzgird nazdist satēr-8 drahm 2
               <lb n="5" xml:id="trc-p1-l5"/>dudīgar satēr-25 sidīgar satēr-10
               <lb n="6" xml:id="trc-p1-l6"/>hā̆mist satēr-43 drahm 2 ◯ C Grāmag nazdist
   superscriptum: [drahm 2]
               <lb n="7" xml:id="trc-p1-l7"/>satēr-3 drahm 3 dudīgar satēr-8 sidīgar
               <lb n="8" xml:id="trc-p1-l8"/>satēr-3 hā̆mist satēr-15 drahm 1 ◯ D Mihrābād
               <lb n="9" xml:id="trc-p1-l9"/>sidīgar satēr-3 drahm 3 ◯ E Rašnūg
               <lb n="10" xml:id="trc-p1-l10"/>nazdist satēr-47 drahm 2 dudīgar
               <lb n="11" xml:id="trc-p1-l11"/>]...[
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0437_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>A [On the] Cemetery first (rate) 39 staters, second (rate)
               <lb n="2" xml:id="trans-p1-l2"/>56 staters, third (rate) 31 staters
               <lb n="3" xml:id="trans-p1-l3"/>1 drahm, altogether 126 staters 1 drahm.
               <lb n="4" xml:id="trans-p1-l4"/>B [On the office of] Tāzgird first (rate) 8 staters 2 drahms,
               <lb n="5" xml:id="trans-p1-l5"/>second (rate) 25 staters, third (rate) 10 staters,
               <lb n="6" xml:id="trans-p1-l6"/>altogether 43 staters 2 drahms. C [On] Grāmag first (rate)
               <lb n="7" xml:id="trans-p1-l7"/>3 staters 3 drahms, second (rate) 8 staters [2 drahms], third (rate)
               <lb n="8" xml:id="trans-p1-l8"/>3 staters, altogether 15 staters 1 drahm. D [On the estate of] Mihrābād
               <lb n="9" xml:id="trans-p1-l9"/>third (rate) 3 staters 3 drahms. E [On] Rašnūg
               <lb n="10" xml:id="trans-p1-l10"/>first (rate) 47 staters 2 drahms, second (rate)
               <lb n="11" xml:id="trans-p1-l11"/>]. . .[
            </ab>
         </div>
      </body>
   </text>
