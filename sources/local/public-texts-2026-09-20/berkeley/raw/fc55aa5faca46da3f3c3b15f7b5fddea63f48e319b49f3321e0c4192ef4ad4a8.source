   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0419_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>plykˈ Y pṭˈ nmṭl dʾlyk
               <lb n="2" xml:id="trl-p1-l2"/>MN ẔK ʾYŠ ʿL bwnˈ ẔNH BYR[Ḥ]
               <lb n="3" xml:id="trl-p1-l3"/>ʾṭwrˈ Y ŠNṬ $X-IIII-III
               <lb n="4" xml:id="trl-p1-l4"/>lwcyk Y pṭˈ S-II Y MN ml
               <lb n="5" xml:id="trl-p1-l5"/>Y ʾMYṭl Y plhwzʾṭˈ
               <lb n="6" xml:id="trl-p1-l6"/>lʾd ṬBNʾ-II pṭmʾn
               <lb n="7" xml:id="trl-p1-l7"/>ʿL plsṭʾlʾn ʾYŠ LʿYNˈ
               <lb n="8" xml:id="trl-p1-l8"/>YḤBWNṭˈ zʾṭʾnplhwˈ ḤṬYMWNṭ
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0419_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Friyag ī pad Namtar dārīg
               <lb n="2" xml:id="trc-p1-l2"/>az ān kas ō bun ēn mā[h]
               <lb n="3" xml:id="trc-p1-l3"/>Ādur ī sāl 37
               <lb n="4" xml:id="trc-p1-l4"/>rōzīg ī pad satēr-2 ī az mar
               <lb n="5" xml:id="trc-p1-l5"/>ī mādar ī Farroxzād
               <lb n="6" xml:id="trc-p1-l6"/>rāy kāh-2 paymān
               <lb n="7" xml:id="trc-p1-l7"/>ō paristārān kas pēš
               <lb n="8" xml:id="trc-p1-l8"/>dād Zādānfarrox āwišt
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0419_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Friyag, der Verwalter in Namtar:
               <lb n="2" xml:id="trans-p1-l2"/>Von jener Person zur „Zentrale“: Diesen Monat
               <lb n="3" xml:id="trans-p1-l3"/>Ādur (9.Monat) des Jahres 37 (668/669 n.Chr.).
               <lb n="4" xml:id="trans-p1-l4"/>Der Tagesration für (im Werte von) 2 Satēr aus dem Vermögen (Zahl)
               <lb n="5" xml:id="trans-p1-l5"/>der Mutter des Farroxzād
               <lb n="6" xml:id="trans-p1-l6"/>wegen Stroh 2 Maß(?)
               <lb n="7" xml:id="trans-p1-l7"/>den Dienern jemand (schon) vorher
               <lb n="8" xml:id="trans-p1-l8"/>gegeben. Zādānfarrox (hat’s) gesiegelt.
            </ab>
         </div>
      </body>
   </text>
</TEI>