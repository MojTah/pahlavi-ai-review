   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!--facs="berlin"-->
            <ab xml:id="MP0403_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>[ʿL] ʾnwšʾḇyȳʾṭ mʾhkˈ nc zʾṭʾnplhwˈ
               <lb n="2" xml:id="trl-p1-l2"/>[   ] . plmʾn ŠRM KBD MRʿḤ ẔNH BYRḤ
               <lb n="3" xml:id="trl-p1-l3"/>[ṭ]yl QDM ŠNṬ $X-I W YWM ʾnglʾn
               <lb n="4" xml:id="trl-p1-l4"/>[   ] ... *ysnpʾnkˈ ʾwsṭʾndʾl ʿL
               <lb n="5" xml:id="trl-p1-l5"/>dʾṭ-... plmwṭ YḆLWNtny ʾNŠWṬʾ
               <lb n="6" xml:id="trl-p1-l6"/>ẔKL I-M pṭˈ YDH Y dsṭwyh(?) ʾy
               <lb n="7" xml:id="trl-p1-l7"/>YḤWWNšn W MN ẔK Y MRʿḤ GBRʾ ʾp̄ẕwn
               <lb n="8" xml:id="trl-p1-l8"/>YḤBWNṭn pṭˈ MRʿḤ Y ʾynʾn MN ...
               <lb n="9" xml:id="trl-p1-l9"/>Y ... ... ʾy YḤWWNšn ŠRM
               <lb n="10" xml:id="trl-p1-l10"/>ʿL[...]
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0403_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>[ō] anōšayād Māhag namāz Zādānfarrox
               <lb n="2" xml:id="trc-p1-l2"/>[   ] . framān drōd was xwadāy ēn māh
               <lb n="3" xml:id="trc-p1-l3"/>[T]īr abar sāl 31 ud rōz Anagrān
               <lb n="4" xml:id="trc-p1-l4"/>[   ]... *yasn-bānag ōstāndār ō
               <lb n="5" xml:id="trc-p1-l5"/>Dād-... framūd burdan mardom
               <lb n="6" xml:id="trc-p1-l6"/>nar 1000 pad dast ī Dastweh(?) ē
               <lb n="7" xml:id="trc-p1-l7"/>bawišn ud az ān ī xwadāy mard abzōn
               <lb n="8" xml:id="trc-p1-l8"/>dādan pad xwadāy ī Ērān az ...
               <lb n="9" xml:id="trc-p1-l9"/>ī ... ... ē bawišn drōd
               <lb n="10" xml:id="trc-p1-l10"/>ō[...]
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0403_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>[An] den mit unsterblicher Erinnerung versehenen Māhag Verehrung! Zādānfarrox
               <lb n="2" xml:id="trans-p1-l2"/>[   ] . Befehl, viel Gesundheit, Herr: diesen Monat
               <lb n="3" xml:id="trans-p1-l3"/>[T]īr (4. Monat) im Jahr 31 und Tag Anagrān (30. Tag)
               <lb n="4" xml:id="trans-p1-l4"/>… (der) yasn-pflegende ōstāndār dem
               <lb n="5" xml:id="trans-p1-l5"/>Dād-... befahl er zu nehmen Leute
               <lb n="6" xml:id="trans-p1-l6"/>männliche 1000 zu Händen des Dastweh(?)
               <lb n="7" xml:id="trans-p1-l7"/>… und von den Männern des Herrn Zuwachs/Vermehrung
               <lb n="8" xml:id="trans-p1-l8"/>(zu) geben für den Herrn von Iran …
               <lb n="9" xml:id="trans-p1-l9"/>des … … Gesundheit!
               <lb n="10" xml:id="trans-p1-l10"/>Dem [...] 
            </ab>
         </div>
      </body>
   </text>
</TEI>