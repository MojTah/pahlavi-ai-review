   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/><!-- Add later facs="LA:UNKNOWN" -->
            <ab xml:id="MP0450_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>ḤS lwcyk Y <persName ref="people:CIr015">mṭryn</persName> lʾd Y BYRḤ
               <lb n="2" xml:id="trl-p1-l2"/>ʾṭwrˈ Y ŠNṬ -X-III-II MN ṬLYN ŠNṬk
               <lb n="3" xml:id="trl-p1-l3"/>YNSḆWNtny X dwlkˈ ◯◯◯◯
               <lb n="4" xml:id="trl-p1-l4"/>◯◯◯◯◯◯
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0450_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>may rōzīg ī <persName ref="people:CIr015">Mihrēn</persName> rāy ī māh
               <lb n="2" xml:id="trc-p1-l2"/>Ādur ī sāl 35 az dō-sālag
               <lb n="3" xml:id="trc-p1-l3"/>stānēnd 10 dōlag ◯◯◯◯
               <lb n="4" xml:id="trc-p1-l4"/>◯◯◯◯◯◯
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0450_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Bezüglich der Wein-Ration des Mihrēn für Monat
               <lb n="2" xml:id="trans-p1-l2"/>Ādur (9 Monat) des Jahres 35: von dem zweijährigen
               <lb n="3" xml:id="trans-p1-l3"/>soll man nehmen 10 Eimer.
               <lb n="4" xml:id="trans-p1-l4"/>◯◯◯◯◯◯
            </ab>
         </div>
      </body>
   </text>
