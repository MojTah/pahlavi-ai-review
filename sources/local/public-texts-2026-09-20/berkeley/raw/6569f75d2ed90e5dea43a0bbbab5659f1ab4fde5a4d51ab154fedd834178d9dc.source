   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl" facs="berkeley:recid:85256-43A.recto.1_ii.jpg/full/full/0/default.jpg"/>
            <ab xml:id="MP0044_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>Y̱LYDWNṭ hlṭ-wndʾṭ ʾwsṭndʾl
               <lb n="2" xml:id="trl-p1-l2"/>pṭyhwyh Y QDM
               <lb n="3" xml:id="trl-p1-l3"/>ckyhʾ W p(ʾ)ṭglʾḇyhʾ [Y]
               <lb n="4" xml:id="trl-p1-l4"/>MNW ẔNH ʾdybʾṭkʾl ʾwb-(š)
               <lb n="5" xml:id="trl-p1-l5"/>wylʾsṭ' W npšṭ' YKʿYMWNyṭ
               <lb n="6" xml:id="trl-p1-l6"/>PWN bhṭbʾl Y PWN
               <lb n="7" xml:id="trl-p1-l7"/><supplied resp="#DW">dst</supplied>krṭ' Y wndʾṭbwlcmṭrʾp̄ṭ
               <lb n="8" xml:id="trl-p1-l8"/><supplied resp="#DW">dʾlyk</supplied> <gap extent="several words" reason="tear"/> <supplied resp="#DW">gw</supplied>(m)ʾlṭk' lʾd ẔN(H)
               <lb n="9" xml:id="trl-p1-l9"/><supplied resp="#DW">BYRḤ</supplied>
               <gap extent="several words" reason="tear"/> Y ŠNṬ
               <lb n="10" xml:id="trl-p1-l10"/><supplied resp="#DW">$$-IIII-IIII</supplied> <gap extent="several words" reason="tear"/> mʾhp̄ylwc'
               <lb n="11" xml:id="trl-p1-l11"/><gap extent="several words" reason="tear"/> ẔNH
               <lb n="12" xml:id="trl-p1-l12"/><gap extent="several words" reason="tear"/>
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0044_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>zād xrad-windād ōstāndār
               <lb n="2" xml:id="trc-p1-l2"/>padēxīh ī abar
               <lb n="3" xml:id="trc-p1-l3"/>čakīhā ud pādīrāyīhā (ī)
               <lb n="4" xml:id="trc-p1-l4"/>kē ēn ayādgār awi-(š)
               <lb n="5" xml:id="trc-p1-l5"/>wirāst ud nibišt estēd
               <lb n="6" xml:id="trc-p1-l6"/>pad Baxtiyār ī pad
               <lb n="7" xml:id="trc-p1-l7"/><supplied resp="#DW">dast</supplied>gird ī Windādburzmihr-ābād
               <lb n="8" xml:id="trc-p1-l8"/><supplied resp="#DW">dārīg</supplied> <gap extent="several words" reason="tear"/> <supplied resp="#DW">gu</supplied>mārdag rāy ēn
               <lb n="9" xml:id="trc-p1-l9"/><supplied resp="#DW">māh </supplied> 
               <gap extent="several words" reason="tear"/> ī sāl
               <lb n="10" xml:id="trc-p1-l10"/><supplied resp="#DW">48</supplied> <gap extent="several words" reason="tear"/> Māhpērōz
               <lb n="11" xml:id="trc-p1-l11"/><gap extent="several words" reason="tear"/> ēn
               <lb n="12" xml:id="trc-p1-l12"/><gap extent="several words" reason="tear"/>
            </ab>
         </div>
         <div type="translation" xml:lang="en">
            <ab xml:id="MP0044_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Ōstāndār with inherited wisdom
               <lb n="2" xml:id="trans-p1-l2"/>(the result of) the prosperity over which
               <lb n="3" xml:id="trans-p1-l3"/>cheques and receipts
               <lb n="4" xml:id="trans-p1-l4"/>on which this memorandum
               <lb n="5" xml:id="trans-p1-l5"/>has been established and written
               <lb n="6" xml:id="trans-p1-l6"/>for Baxtiyār
               <lb n="7" xml:id="trans-p1-l7"/><supplied resp="#DW">the manager</supplied> (line 8) on the estate of Windādburzmihr-ābād
               <lb n="8" xml:id="trans-p1-l8"/><gap extent="several words" reason="tear"/> for the appointee's sake this
               <lb n="9" xml:id="trans-p1-l9"/><supplied resp="#DW">month</supplied>
                 <gap extent="several words" reason="tear"/> of the year
               <lb n="10" xml:id="trans-p1-l10"/><supplied resp="#DW">48</supplied> <gap extent="several words" reason="tear"/> Māhperōz
               <lb n="11" xml:id="trans-p1-l11"/><gap extent="several words" reason="tear"/> this
               <lb n="12" xml:id="trans-p1-l12"/><gap extent="several words" reason="tear"/>
            </ab>
         </div>
      </body>
   </text>
