   <text>
      <body>
         <div type="transliteration" xml:lang="pal">
            <pb xml:id="pb-1r-trl"/>
            <ab xml:id="MP0505_trl-p1">
               <lb n="1" xml:id="trl-p1-l1"/>plykˈ Y pṭˈ nmṭl dʾlyk
               <lb n="2" xml:id="trl-p1-l2"/>lwcyk Y BYRḤ ʾrṭwhšṭ
               <lb n="3" xml:id="trl-p1-l3"/>W BYRḤ hwrdṭ Y LẔNH ŠNṬ $$
               <lb n="4" xml:id="trl-p1-l4"/>lʾd ḤG G-III-II ʿL ......
               <lb n="5" xml:id="trl-p1-l5"/>Y lsyk W wlcyk YḤBWNṭ zʾṭʾnplhwˈ(?)
               <lb n="6" xml:id="trl-p1-l6"/>(ḤṬYMWNṭ)
            </ab>
         </div>
         <div type="transcription" xml:lang="pal">
            <ab xml:id="MP0505_trc-p1">
               <lb n="1" xml:id="trc-p1-l1"/>Friyag ī pad Namtar dārīg
               <lb n="2" xml:id="trc-p1-l2"/>rōzīg ī māh Ardwahišt
               <lb n="3" xml:id="trc-p1-l3"/>ud māh Hordād ī im sāl 40
               <lb n="4" xml:id="trc-p1-l4"/>rāy gandum grīw-5 ō ......
               <lb n="5" xml:id="trc-p1-l5"/>ī rahīg ud warzīg dād Zādānfarrox(?)
               <lb n="6" xml:id="trc-p1-l6"/>(āwišt)
            </ab>
         </div>
         <div type="translation" xml:lang="de">
            <ab xml:id="MP0505_trans-p1">
               <lb n="1" xml:id="trans-p1-l1"/>Friyag, der Verwalter in Namtar:
               <lb n="2" xml:id="trans-p1-l2"/>Der Tagesration des Monats Ardwahišt (2. Monat)
               <lb n="3" xml:id="trans-p1-l3"/>und des Monats Hordād (3.Monat) dieses Jahres 40
               <lb n="4" xml:id="trans-p1-l4"/>wegen Weizen 5 grīw dem ......,
               <lb n="5" xml:id="trans-p1-l5"/>dem Knaben und (Land-)Arbeiter, gegeben.Zādānfarrox(?) (hat’s)
               <lb n="6" xml:id="trans-p1-l6"/>gesiegelt.
            </ab>
         </div>
      </body>
   </text>
</TEI>